# ----- 微信支付配置 (API v3) -----
# 商户平台获取：https://pay.weixin.qq.com
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://nihplod.cn/api/pay/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://nihplod.cn/api/pay/refund-notify

# 微信支付平台公钥配置 (推荐模式)
# 在商户平台 -> 账户中心 -> API 安全 -> 微信支付公钥中获取
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=""

# 商户 API 私钥 (apiclient_key.pem 内容)
WECHAT_PAY_KEY_PEM=""

# ----- 支付宝支付配置 -----
