# ===========================================
# NIHPLOD.CN 生产环境变量
# ===========================================

# ----- 应用配置 -----
NEXT_PUBLIC_APP_NAME=NIHPLOD
NEXT_PUBLIC_APP_URL=https://nihplod.cn
NEXT_PUBLIC_APP_DESCRIPTION=逆转时光

# ----- 数据库配置 (Supabase PostgreSQL Transaction Pooler) -----
# 使用端口 6543 + pgbouncer=true 支持 Serverless 环境的高并发连接
DATABASE_URL="postgresql://postgres.gggmklbpdhsdwmmbkgzg:Moidas123!@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ----- 认证配置 -----
JWT_SECRET=14689694242626973cfa78262b469786daff8bd4512f73d12c25c205bcb09747
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@nihplod.cn
ADMIN_PASSWORD=admin123

# ----- AI 配置 -----

# AI 总开关 (true/false)
AI_ENABLED=true

# AI 提供商配置
AI_PROVIDER=openai
AI_VISION_PROVIDER=openai
AI_MODEL=gpt-4o

# OpenAI API Key (用于问卷分析 + 面部分析)
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API Key (可选备用，用于 Claude Vision)
# 获取地址: https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# DeepSeek (可选，用于对话式顾问)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ----- 邮件配置 (SMTP) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nihplod.cn
SMTP_FROM_NAME=NIHPLOD
NOTIFICATION_EMAIL=

# ----- 文件上传配置 -----
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif

# ----- 速率限制配置 -----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ----- 文件存储配置 (Supabase Storage) -----
STORAGE_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://gggmklbpdhsdwmmbkgzg.supabase.co
