# ==============================================================================
# NIHPLOD.CN 生产环境配置文件 (.env.production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心应用配置 (Core App Config)
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_BASE_URL="https://nihplod.cn"
NEXT_PUBLIC_WWW_URL="https://www.nihplod.cn"

# ------------------------------------------------------------------------------
# 2. 数据库配置 (Prisma / PostgreSQL)
# ------------------------------------------------------------------------------
# 生产环境使用服务器本地数据库连接
DATABASE_URL="postgresql://nihplod_user:Moidas888!@localhost:5432/nihplod_db"

# ------------------------------------------------------------------------------
# 3. 认证与安全配置 (Authentication & Security)
# ------------------------------------------------------------------------------
# JWT & NextAuth 密钥 (必须保持 32 位以上随机字符)
JWT_SECRET=14689694242626973cfa78262b469786daff8bd4512f73d12c25c205bcb09747
JWT_EXPIRES_IN=7d

# 管理后台初始账号
ADMIN_EMAIL=hank.wang@nihplod.cn
ADMIN_PASSWORD=whk35168

# ------------------------------------------------------------------------------
# 4. 企业微信集成控制 (WeCom Integration)
# ------------------------------------------------------------------------------
# 企业基础 ID
WECOM_CORP_ID=ww27c38ff0313efbec

# 自建应用配置 (用于高级 API, 如读取 Sheet)
# WECOM_APP_AGENT_ID=1000002
# WECOM_APP_SECRET=B-aw0SZ_7zWr0yBTkfPEJLRpGRq16IfbAy8-sGX25yU

# 在线文档 (Sheet) ID
# WECOM_SHEET_DOC_ID=AQYAqwY2ANwCNugTKYuA0TK0kLc3V

# 群机器人 Webhooks (用于即时消息通知)
WECOM_JOBS_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=65c2d83b-76f8-4932-a32f-55e3ee860dd8
WECOM_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=565b06ca-a76d-4921-9d02-9e91fca8bc8e

# ------------------------------------------------------------------------------
# 5. 文件存储与上传 (Storage & Uploads)
# ------------------------------------------------------------------------------
# 存储模式: local (服务器本地存储) | oss (阿里云 OSS 云存储)
STORAGE_MODE=supabase

# 上传限制
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif

# ------------------------------------------------------------------------------
# 6. 第三方服务配置 (External Services)
# ------------------------------------------------------------------------------
# 高德地图 (前端地图定位服务)
NEXT_PUBLIC_AMAP_KEY=94e6ade4e8b23b2872d361c6784d0f66
NEXT_PUBLIC_AMAP_SECRET=c4de15af0445dd1973fc4d5840ceac3b

# 腾讯云 SMS (可选短信登录)
# TENCENT_SECRET_ID="AKIDp5L2m8v6N3x1P4q6S8t0V1W5Z9y2"
# TENCENT_SECRET_KEY="G8h3K9L2n5M7x1P4q6S8t0V1W5Z9y2X3"
# TENCENT_SMS_APP_ID="1400876543"
# TENCENT_SMS_SIGN_NAME="NIHPLOD"
# TENCENT_SMS_TEMPLATE_ID="2098765"

# 阿里云 OSS (可选素材上传)
# OSS_REGION="oss-cn-shanghai"
# OSS_ACCESS_KEY_ID="LTAI5tD8e4g5Gv6R7y9mXz2P"
# OSS_ACCESS_KEY_SECRET="F8h3K9L2n5M7x1P4q6S8t0V1W5Z9y2X3"
# OSS_BUCKET="nihplod-media"
# OSS_ENDPOINT="oss-cn-shanghai.aliyuncs.com"

# ------------------------------------------------------------------------------
# 7. 支付配置 (Payments)
# ------------------------------------------------------------------------------

# 微信支付 (API v3)
# 获取方式说明：
# 1. WECHAT_APP_ID：登录微信商户平台【产品中心-开发配置】获取AppID。
# 2. WECHAT_MCH_ID：登录微信商户平台首页，右上角可见商户号。
# 3. WECHAT_API_V3_KEY：在商户平台【API安全-APIv3密钥】自行设置并保存。
# 4. WECHAT_CERT_SERIAL_NO：在【API证书】下载证书后，查看apiclient_cert.pem文件或平台显示的证书序列号。
# 5. WECHAT_PRIVATE_KEY_PATH：API证书私钥文件的服务器绝对路径（如apiclient_key.pem）。

# WECHAT_APP_ID="wxd7e6b5a4c3f2e1d0"
# WECHAT_MCH_ID="1670987654"
# WECHAT_API_V3_KEY="Nihplod_Wechat_Pay_V3_Key_2024_01"
# WECHAT_CERT_SERIAL_NO="3A5C7E9B1D0F2E4A6C8B0D2F4E6A8C0B2D4E6F8"
# WECHAT_PRIVATE_KEY_PATH="/var/www/NIHPLOD-Homepage.CN/certs/apiclient_key.pem"


# 支付宝支付 (可选)
# 获取方式说明：
# 1. ALIPAY_APP_ID：登录支付宝开放平台，创建应用后在应用详情页获取。
# 2. ALIPAY_PRIVATE_KEY：在本地生成RSA2密钥对，私钥内容填写于此。
# 3. ALIPAY_PUBLIC_KEY：支付宝开放平台应用详情页上传公钥后，平台生成的支付宝公钥。
# 4. ALIPAY_NOTIFY_URL：你的后端用于接收支付宝异步通知的接口地址。
# 5. ALIPAY_RETURN_URL：支付完成后用户跳转的前端页面地址。

# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=""
# ALIPAY_PUBLIC_KEY=""
# ALIPAY_NOTIFY_URL=https://nihplod.cn/api/pay/alipay-notify
# ALIPAY_RETURN_URL=https://nihplod.cn/pay/success

# ------------------------------------------------------------------------------
# 8. 频率限制 (Rate Limiting)
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000