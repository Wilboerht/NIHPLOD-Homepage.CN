// Prisma Schema 定义
// 文档: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 产品相关
// ============================================

model Product {
  id            String         @id @default(cuid())
  name          String         // 产品名称（中文）
  nameEn        String         // 产品名称（英文）
  slug          String         @unique // URL 标识
  description   String         @db.Text // 产品描述
  price         Decimal        @db.Decimal(10, 2) // 参考价格
  capacity      String?        // 规格容量
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  images        Image[]        // 产品图片
  purchaseLinks PurchaseLink[] // 多平台购买链接
  ingredients   String?        @db.Text // 成分说明
  usage         String?        @db.Text // 使用方法
  benefits      String[]       // 功效标签
  origin        String?        // 产地
  order         Int            @default(0) // 排序（数字越小越靠前）
  featured      Boolean        @default(false) // 是否推荐
  published     Boolean        @default(false) // 是否发布
  pointRedeemable Boolean      @default(false) // 是否可在用户面板积分兑换（兑换扣分 = ⌊价格 ÷ 当前兑礼率⌋）
  geoFaqs       Json?          // AI 生成的 GEO FAQ 数据
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  pointRedemptions PointRedemption[]

  @@index([categoryId])
  @@index([published, order])
  @@index([featured, order])
  @@index([pointRedeemable, published])
}

// 购买链接（支持多平台）
model PurchaseLink {
  id        String   @id @default(cuid())
  platform  String   // 平台名称（如：天猫、京东、小红书、官方商城）
  url       String   // 购买链接
  order     Int      @default(0) // 排序
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    // 分类名称（中文）
  nameEn    String    // 分类名称（英文）
  slug      String    @unique // URL 标识
  icon      String?   @db.Text // 分类图标（SVG 代码）
  order     Int       @default(0) // 排序
  visible   Boolean   @default(true) // 是否在前台展示
  products  Product[] // 关联产品
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([visible, order])
}

model Image {
  id        String   @id @default(cuid())
  url       String   // 图片路径
  alt       String?  // 替代文本
  order     Int      @default(0) // 排序
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productId])
}




// ============================================
// 职位管理
// ============================================

model Job {
  id           String   @id @default(cuid())
  title        String   // 职位名称（中文）
  titleEn      String?  // 职位名称（英文）
  location     String   // 工作地点
  type         String   // 职位类型 (fulltime, parttime, intern)
  description  String   @db.Text // 职责描述
  requirements String   @db.Text // 任职要求
  salary       String?  // 薪资范围（可选）
  longitude    Float?   // 经度
  latitude     Float?   // 纬度
  order        Int      @default(0) // 排序
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  applications JobApplication[] // 该职位的申请记录

  @@index([published, order])
}

// ============================================
// 职位申请
// ============================================

model JobApplication {
  id         String   @id @default(cuid())
  jobId      String   // 申请的职位ID
  name       String   // 申请人姓名
  phone      String   // 手机号
  resumePath String   // 简历文件路径
  status     String   @default("pending") // 状态: pending, reviewed, interviewed, rejected, hired
  notes      String?  @db.Text // 备注
  folderId   String?  // 分类夹ID（可选）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  job    Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  folder ApplicationFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([folderId])
}

// ============================================
// 申请分类夹
// ============================================

model ApplicationFolder {
  id           String   @id @default(cuid())
  name         String   // 分类夹名称
  description  String?  // 描述说明
  order        Int      @default(0) // 排序
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  applications JobApplication[] // 该分类夹下的申请

  @@index([order])
}


// 联系留言
// ============================================

model ContactMessage {
  id        String    @id @default(cuid())
  name      String    // 留言人姓名
  phone     String    // 联系电话
  type      String?   // 留言类型 (咨询、合作等)
  content   String    @db.Text // 留言内容
  reply     String?   @db.Text // 管理员回复
  repliedAt DateTime? // 回复时间
  read      Boolean   @default(false) // 是否已读
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([read, createdAt(sort: Desc)])
}




// ============================================
// C端用户系统
// ============================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum MembershipLevel {
  REGULAR // 普通会员（完成注册）
  SILVER  // 银卡会员（官方店铺累计消费满 ¥1,000）
  GOLD    // 金卡会员（累计消费满 ¥5,000）
  DIAMOND // 钻石卡会员（累计消费满 ¥10,000）
}

model User {
  id            String     @id @default(cuid())
  phone         String     @unique              // 手机号（唯一）
  phoneVerified Boolean    @default(false)      // 手机验证状态
  password      String?                         // 密码（哈希后）
  nickname      String?                         // 昵称
  avatar        String?                         // 头像 URL
  status        UserStatus @default(ACTIVE)     // 账号状态

  // 密码策略
  passwordChangedAt DateTime?                   // 上次密码修改时间
  passwordExpiresAt DateTime?                   // 密码过期时间（null 表示未启用过期策略）

  // 多租户预留：如需租户隔离，添加 tenantId String? 字段，并在所有查询中添加 WHERE tenantId = ? 条件

  // 微信登录
  wechatOpenId  String?   @unique               // 微信 OpenID
  wechatUnionId String?                         // 微信 UnionID

  // 会员等级（四档，按累计消费实时判定，永久有效）
  membershipLevel MembershipLevel @default(REGULAR)
  totalSpent      Int              @default(0) // 历史购买金额（元，退款扣减），等级判定依据
  // 各档首次达档时间（仅成长展示，不产生有效期）
  silverActivatedAt  DateTime?
  goldActivatedAt    DateTime?
  diamondActivatedAt DateTime?
  // 生日（生日积分发放依据）：首次设置后锁定，修改需人工客服
  birthday             DateTime?
  birthdayLocked       Boolean   @default(false)
  lastBirthdayRewardYear Int?    // 最近一次生日积分发放的自然年（幂等，每年一次）

  // 关联
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  spentSyncRecords SpentSyncRecord[]
  loginAttempts    LoginAttempt[]
  passwordHistory  PasswordHistory[] @relation("UserPasswordHistory")
  spentAdjustmentApplications SpentAdjustmentApplication[]
  spentImportRows SpentImportRow[]
  pointLedger PointLedger[]
  pointBalance PointBalance?
  pointRedemptions PointRedemption[]
  addresses UserAddress[]
  membershipLevelChanges MembershipLevelChange[]

  oauthCodes    OAuthAuthorizationCode[] @relation("OAuthCodeUser")
  oauthSessions OAuthSession[]           @relation("OAuthSessionUser")
  oauthConsents UserConsent[]            @relation("UserConsentUser")

  externalIdentities ExternalIdentity[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([membershipLevel])
  @@index([wechatUnionId])
  // phone 和 wechatOpenId 已有 @unique 索引，无需重复 @@index
  @@index([passwordExpiresAt])
}

/**
 * 外部平台身份（多平台聚合框架）
 * 一个用户可绑定多个外部平台身份（微信开放平台/服务号/小程序，未来 Apple/支付宝等）。
 * 与 User.wechatOpenId/wechatUnionId 双写过渡：旧列保留供现有流程使用，新列作为
 * 通用查询入口，后续独立任务再收口。
 */
model ExternalIdentity {
  id        String   @id @default(cuid())
  userId    String
  provider  String   // wechat_open | wechat_mp | wechat_miniprogram | ...（未来 apple / alipay 等）
  subjectId String   // 平台内唯一标识（如微信 openid）
  unionId   String?  // 微信系 UnionID（跨应用聚合）
  metadata  Json?    // 昵称/头像等快照
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subjectId])
  @@index([userId])
  @@index([provider, unionId])
}

// ============================================
// 用户认证增强
// ============================================

/**
 * Refresh Token 存储
 * 用于实现 Token 刷新机制
 */
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  clientId  String?                               // OAuth client_id（OAuth 刷新令牌使用）
  token     String   @db.Text                      // 加密后的 refresh token
  expiresAt DateTime                               // 过期时间
  revokedAt DateTime?                              // 撤销时间（已登出）

  // 设备/会话信息
  deviceName  String?  // 设备名称/浏览器摘要
  deviceInfo  String?  // 原始 UA 摘要
  ipAddress   String?  // 登录 IP
  userAgent   String?  @db.Text

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, expiresAt])
  @@index([token])
  @@index([userId, revokedAt, expiresAt])
  @@index([userId, clientId, revokedAt, expiresAt])
  @@index([expiresAt])
}

/**
 * 登录尝试记录
 * 用于防止账户爆破和跟踪异常登录
 * 覆盖 C端用户（password/sms）和管理员（admin）登录
 */
model LoginAttempt {
  id        String   @id @default(cuid())
  identifier String                            // 登录标识：手机号（C 端）或邮箱（管理员），HMAC 哈希存储
  userId    String?                            // 账号维度关联（2026-09 起写入；历史行无此值，identifier 兜底）
  type      String   @default("password")      // password | sms | admin — 应用层 Zod 约束，未用 Prisma enum 因保持灵活
  success   Boolean                            // 是否成功
  reason    String?                            // 失败原因（如：code_invalid、user_not_found 等）
  ipAddress String?                            // IP 地址
  userAgent String?  @db.Text                  // User Agent
  clientId  String?                            // OAuth Client ID（来源子项目）

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, createdAt(sort: Desc)])
  @@index([identifier, success, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

/**
 * 密码历史
 * 记录用户最近 N 个密码哈希，用于防止重复使用历史密码。
 * 应用层负责限制历史数量（默认 5 条）。
 */
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  password  String   // 密码哈希（bcrypt）
  createdAt DateTime @default(now())

  user User @relation("UserPasswordHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ============================================
// OAuth 2.0 / SSO 一网通
// ============================================

model OAuthClient {
  id                  String   @id @default(cuid())
  clientId            String   @unique     // 客户端 ID（公开）
  clientSecret        String               // 客户端密钥（bcrypt 哈希存储）
  previousSecretHash  String?              // 密钥轮换过渡期旧 secret 的 bcrypt hash（多实例共享，验证时仅 5 分钟过渡期内有效）
  secretRotatedAt     DateTime?            // 最近一次密钥轮换时间（用于判定过渡期窗口）
  name                String               // 应用名称
  redirectUris        String[]             // 允许的回调 URL 列表
  postLogoutRedirectUris String[]            // 允许的 RP-Initiated Logout 返回地址
  scopes              String[]             // 允许的权限范围
  isActive            Boolean  @default(true)
  isPublic            Boolean  @default(false)  // Public Client (SPA/移动端/桌面端不传 client_secret)
  backchannelLogoutUri String?            // Backchannel Logout URI
  webhookUri          String?              // 用户资料变更 Webhook 推送地址（可空，未配置则不推送）
  codeTtlSeconds      Int      @default(300)    // 授权码有效期（秒），默认 5 分钟
  accessTokenTtlSeconds Int    @default(900)    // Access Token 有效期（秒），默认 15 分钟
  tenantId            String?              // 多租户预留：当前为 null 表示全局共享
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  authorizationCodes OAuthAuthorizationCode[] @relation("OAuthCodeClient")
  sessions           OAuthSession[]          @relation("OAuthSessionClient")
  consents           UserConsent[]           @relation("UserConsentClient")

  @@index([isActive])
  @@index([tenantId])
  @@index([name])
}

model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  code                String    @unique     // 授权码（SHA-256 哈希存储）
  clientId            String                // 关联的 OAuthClient.clientId
  userId              String                // 关联的用户 ID
  redirectUri         String                // 回调 URL 快照
  scopes              String[]              // 请求的权限范围
  codeChallenge       String?               // PKCE code_challenge
  codeChallengeMethod String?               // PKCE method（S256）
  nonce               String?               // OIDC nonce（防重放）
  expiresAt           DateTime              // 过期时间（5 分钟）
  used                Boolean   @default(false)
  createdAt           DateTime  @default(now())

  client OAuthClient @relation("OAuthCodeClient", fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation("OAuthCodeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([clientId, used, expiresAt])
}

model OAuthSession {
  id                   String    @id @default(cuid())
  userId               String
  clientId             String
  sessionId            String    @unique
  authorizationCodeId  String?   // 关联的授权码（用于追溯）。无 FK 约束：授权码定期清理，需保留 session 记录
  scopes               String[]
  createdAt            DateTime  @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?

  client OAuthClient @relation("OAuthSessionClient", fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation("OAuthSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clientId])
  @@index([userId, revokedAt])
  @@index([revokedAt])
  @@index([expiresAt])
  @@index([clientId])
}

model UserConsent {
  id        String    @id @default(cuid())
  userId    String
  clientId  String
  scopes    String[]
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  client OAuthClient @relation("UserConsentClient", fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation("UserConsentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
}

model SsoAuditEvent {
  id         String   @id @default(cuid())
  event      String               // authorize | token | introspect | logout | userinfo | backchannel_logout | profile_webhook | consent | status_change
  userId     String?              // 关联用户
  clientId   String?              // 关联子项目
  clientName String?              // 子项目名称快照
  ip         String?              // IP 地址
  userAgent  String?  @db.Text    // User Agent
  detail     Json?                // 事件详情
  success    Boolean  @default(true)
  tenantId   String?              // 多租户预留
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([event, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([createdAt])
}

/**
 * Backchannel Logout 投递失败补偿队列
 * 同步重试耗尽后落库，由 cron 任务按 nextRetryAt 指数退避周期重投
 */
model BackchannelLogoutFailure {
  id          String   @id @default(cuid())
  userId      String
  clientId    String
  payload     Json                 // 重投所需数据（如 logout_token 的 sid）
  attempts    Int      @default(0) // 已重投次数
  nextRetryAt DateTime             // 下一次重投时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([nextRetryAt])
}

/**
 * 用户资料变更 Webhook 投递失败补偿队列
 * 与 BackchannelLogoutFailure 并列（logout 专用，不混用）：
 * 同步重试耗尽后落库，由 cron 任务按 nextRetryAt 指数退避周期重投
 */
model WebhookDeliveryFailure {
  id          String   @id @default(cuid())
  userId      String
  clientId    String
  payload     Json                 // 重投所需数据（事件名 + 资料快照）
  attempts    Int      @default(0) // 已重投次数
  nextRetryAt DateTime             // 下一次重投时间
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([nextRetryAt])
}

model SmsCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String   // 验证码 SHA-256 哈希
  type      String   @default("login")         // login | bind | reset
  used      Boolean  @default(false)
  attempts  Int      @default(0) // 校验失败次数：达到上限（应用层 SMS_CODE_MAX_ATTEMPTS=5）即作废该码，防爆破
  ipAddress String?  // 发送时的客户端 IP（可选，用于 IP 绑定校验）
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, type])
  @@index([expiresAt])
  @@index([phone, used, expiresAt])

  // 注意：以下约束通过 raw SQL migration 实现（Prisma 不支持 partial unique index）：
  // migration 20260710100000_smscode_partial_unique_index
  // CREATE UNIQUE INDEX "SmsCode_phone_type_used_false_key" ON "SmsCode"("phone","type") WHERE "used" = false;
}

// ============================================
// 审计日志
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // 操作类型: create_admin, update_admin, delete_admin, login, logout 等
  targetType String  // 目标类型: admin, product, category, job, message, application 等
  targetId  String?  // 目标记录ID
  detail    Json?    // 操作详情（变更前后数据快照等）
  ipAddress String?  // 操作者IP
  userAgent String?  @db.Text // 浏览器UA
  adminId   String?
  userId    String?  // C 端用户事件使用
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([adminId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

// ============================================
// 限流记录（支持多实例部署）
// ============================================

model RateLimitRecord {
  id          String   @id @default(cuid())
  key         String   // 如 "login:192.168.1.1"
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([key, windowStart])
  // 供定期清理过期记录（windowStart < 阈值）的 deleteMany 查询命中
  @@index([windowStart])
}

// ============================================
// 会员体系
// ============================================

// 消费补录渠道（全渠道凭证：电商订单号或线下小票号）
enum SpentAdjustmentChannel {
  TMALL // 天猫
  JD // 京东
  MINIPROGRAM // 微信小程序
  OFFLINE // 线下专柜
  OTHER // 其他
}

enum SpentAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

// 消费补录申请：用户提交全渠道消费凭证，管理员审核通过后手动累加历史消费金额（提升会员等级）
model SpentAdjustmentApplication {
  id            String                   @id @default(cuid())
  userId        String
  channel       SpentAdjustmentChannel
  orderNo       String // 电商订单号或线下小票号
  amountClaimed Int? // 用户申报金额（元）
  purchasedAt   DateTime? // 消费日期（不限制时间范围）
  images        String[] // 凭证截图 URL（选填，最多 3 张）
  note          String? @db.Text // 备注
  status        SpentAdjustmentStatus    @default(PENDING)
  reviewAmount  Int? // 审核核实金额（元，以人工核实为准）
  reviewNote    String? @db.Text // 驳回原因/审核备注
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy Admin? @relation("SpentAdjustmentReview", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

// 外部商城消费额同步幂等记录（商城侧单据号唯一，防止重复上报重复入账）
model SpentSyncRecord {
  id         String   @id @default(cuid())
  userId     String
  reference  String   // 商城侧唯一单据号（幂等键）
  spentDelta Int      // 该单据对应的消费额变动（元，正加负减）
  note       String?  @db.Text
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reference]) // 幂等防重：同一用户同一单据只入账一次
  @@index([userId, createdAt(sort: Desc)])
}

// 管理端 Excel 批量导入消费记录的逐行结果状态
enum SpentImportRowStatus {
  SUCCESS
  DUPLICATE
  ERROR
}

// 管理端 Excel 批量导入批次（消费记录一键导入）
model SpentImportBatch {
  id            String   @id @default(cuid())
  adminId       String
  fileName      String   // 上传文件名（清洗后）
  fileHash      String?  // 文件内容 MD5（仅审计参考，幂等以逐行 reference 为准）
  totalRows     Int      // Excel 数据行总数
  successRows   Int      // 成功入账行数
  duplicateRows Int      @default(0) // 幂等命中（重复入账被跳过）行数
  errorRows     Int      // 失败行数
  totalAmount   Int      // 实际净入账金额（元，成功行金额之和）
  undoneAt      DateTime? // 整批撤销时间（撤销后禁止再次撤销）
  createdAt     DateTime @default(now())

  admin Admin            @relation(fields: [adminId], references: [id])
  rows  SpentImportRow[]

  @@index([createdAt(sort: Desc)])
}

// 导入批次内的逐行明细（保存 reference 与金额，支撑整批撤销）
model SpentImportRow {
  id          String                 @id @default(cuid())
  batchId     String
  phone       String                 // 行内手机号（原样保存，便于回溯）
  amount      Int                    // 消费额变动（元，正加负减）
  channel     SpentAdjustmentChannel? // 渠道（选填）
  orderNo     String?                // 订单号/小票号（选填）
  purchasedAt DateTime?              // 消费日期（选填）
  note        String?                @db.Text
  reference   String                 // 幂等键（import:{fileHash}:{rowIndex} 或含订单号）
  status      SpentImportRowStatus
  error       String?                @db.Text // 失败原因（预览/执行阶段）
  userId      String?                // 成功定位到的用户（失败行可能为空）
  createdAt   DateTime               @default(now())

  batch SpentImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([userId, createdAt(sort: Desc)])
}

model MembershipBenefit {
  id          String          @id @default(cuid())
  level       MembershipLevel @unique
  name        String          // 等级名称（如：普通会员）
  nameEn      String?         // 英文名称
  icon        String?         // 图标 emoji/SVG
  minSpent    Int             // 升级所需最低历史消费金额（元）
  maxSpent    Int?            // 该等级消费上限（最高等级为 null）
  benefits    Json            // 权益列表 [{ icon, title, desc }]
  colorClass  String?         // Tailwind 颜色类名
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
}

// ============================================
// 积分体系（2026-09 重新上线：消费 1 元 = 1 分，所有等级发放，立即到账无冻结期，普通档仅累积不可兑礼）
// 账本在官网 SSO（权威），兑礼入口在商城侧（银卡及以上）。
// ============================================

enum PointLedgerType {
  CONSUME // 消费发放（1 元 = 1 分，立即到账，6 个月过期）
  REFUND // 退款冲正（负值；先冲冻结再冲可用，可用可负）
  BIRTHDAY // 生日积分（每年一次，按生日当天当前等级 50/100/200）
  REDEEM // 兑礼扣减（FIFO 消耗最旧可用流水）
  EXPIRE // 过期扣减
}

// 积分流水（FIFO 消耗：发放类流水记录 remaining，兑礼/过期按时间序消耗）
model PointLedger {
  id          String          @id @default(cuid())
  userId      String
  type        PointLedgerType
  amount      Int             // 正加负减
  remaining   Int?            // 剩余未消耗（仅发放类正向流水，null=非消耗对象）
  reference   String          // 幂等键（消费单据 reference / birthday:{userId}:{year} / redeem:{单号}）
  note        String?         @db.Text
  frozenUntil DateTime?       // 稳定期解冻时间（已废弃：无冻结期，保留列向后兼容）
  releasedAt   DateTime?      // 到账时间（无冻结期：发放即到账，恒非空）
  expiresAt    DateTime?      // 过期时间（发放后 6 个月）
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reference]) // 幂等防重
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type, expiresAt])
}

// 积分余额（可用可负；frozen 列已废弃恒为 0，无冻结期）
model PointBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  available Int      @default(0) // 可用积分（退款超兑时可负）
  frozen    Int      @default(0) // 冻结积分（已废弃：无冻结期，恒为 0）
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 收货地址簿（积分兑礼履约寄送用；多地址 + 默认地址；仅用于礼品寄送）
model UserAddress {
  id        String   @id @default(cuid())
  userId    String
  recipient String   // 收货人姓名
  phone     String   // 收货手机号
  region    String   // 省市区
  detail    String   // 详细地址（街道、门牌号等）
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 会员等级变更轨迹（升档/降档实时记录；判级见 points.ts LEVEL_THRESHOLDS）
model MembershipLevelChange {
  id        String          @id @default(cuid())
  userId    String
  fromLevel MembershipLevel
  toLevel   MembershipLevel
  reference String          // 幂等键（与 SpentSyncRecord.reference 一致）
  note      String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reference]) // 幂等防重：同一单据只记一次等级变更
  @@index([userId, createdAt(sort: Desc)])
}

// 用户积分兑换记录（兑换产品来自产品库；名称/价格/扣分/收货地址快照，管理端履约）
model PointRedemption {
  id          String                  @id @default(cuid())
  userId      String
  productId   String?                 // 产品从产品库删除时置空，历史记录保留快照
  productName String                  // 兑换时的产品名称快照
  priceYuan   Decimal                 @db.Decimal(10, 2) // 兑换时的参考价格快照
  points      Int                     // 实际扣减积分（⌊价格 ÷ 当时兑礼率⌋）
  status      PointRedemptionStatus   @default(PENDING)
  reference   String                  // 幂等键（与 PointLedger REDEEM 流水 reference 一致）
  recipient   String?                 // 收货人姓名快照（履约寄送用）
  phone       String?                 // 收货手机号快照
  address     String?                 // 完整收货地址快照（省市区 + 详细地址）
  carrier     String?                 // 承运商（如 SF=顺丰），履约时写入
  waybillNo   String?                 // 运单号（履约时录入，用户端据此查询物流轨迹）
  fulfilledAt DateTime?
  createdAt   DateTime                @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([userId, reference]) // 幂等防重：同一请求单只产生一条兑换记录
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// 兑换履约状态
enum PointRedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

// ============================================
// 系统管理
// ============================================

enum AdminRole {
  // 注意：AdminRole 与其他 enum 大小写不一致（lowercase vs UPPERCASE），
  // 由于已投入生产且有 DB 记录，保留当前值避免 breaking change
  owner
  admin
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

model Admin {
  id              String      @id @default(cuid())
  email           String      @unique // 登录邮箱
  password        String      // 加密密码
  name            String      // 显示名称
  role            AdminRole   @default(admin)
  status          AdminStatus @default(ACTIVE) // 账号状态
  deletedAt       DateTime?   // 软删除时间
  totpSecret      String?     // 加密后的 TOTP secret
  totpEnabled     Boolean     @default(false)
  totpBackupCodes String?     @db.Text // 加密存储的备用码 JSON 数组
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  auditLogs AuditLog[] // 审计日志关联
  spentAdjustmentReviews SpentAdjustmentApplication[] @relation("SpentAdjustmentReview")
  spentImportBatches SpentImportBatch[]

  @@index([status])
  @@index([deletedAt])
  @@index([role])
}

// ============================================
// Token 黑名单（多实例共享）
// ============================================

enum TokenBlacklistType {
  access_token
  user
  logout_jti
  wechat_exchange_token
  internal_api_nonce
  dpop_jti
}

model TokenBlacklist {
  id        String              @id @default(cuid())
  type      TokenBlacklistType  // access_token: 单条 token 撤销; user: 用户全局拉黑
  key       String              @unique // jti、userId 或带前缀的防重放记录（如 nonce:xxx、dpop-jti:xxx）
  reason    String?             // 拉黑原因（仅 user 类型使用）
  expiresAt DateTime            // 自然过期时间，与 token 最大过期一致
  createdAt DateTime            @default(now())

  @@index([type])
  @@index([expiresAt])
}
