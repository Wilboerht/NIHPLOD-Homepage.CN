// Prisma Schema 定义
// 文档: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 产品相关
// ============================================

model Product {
  id            String         @id @default(cuid())
  name          String         // 产品名称（中文）
  nameEn        String         // 产品名称（英文）
  slug          String         @unique // URL 标识
  description   String         @db.Text // 产品描述
  price         Decimal        @db.Decimal(10, 2) // 参考价格
  capacity      String?        // 规格容量
  purchaseUrl   String?        // 外部购买链接（保留兼容，deprecated）
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  images        Image[]        // 产品图片
  purchaseLinks PurchaseLink[] // 多平台购买链接
  ingredients   String?        @db.Text // 成分说明
  usage         String?        @db.Text // 使用方法
  benefits      String[]       // 功效标签
  order         Int            @default(0) // 排序（数字越小越靠前）
  featured      Boolean        @default(false) // 是否推荐
  published     Boolean        @default(false) // 是否发布
  // 站内购买设置
  allowDirectBuy Boolean       @default(false) // 是否允许站内购买
  stock          Int           @default(0) // 库存数量
  salesCount     Int           @default(0) // 销量统计
  cartItems      CartItem[]    // 关联购物车
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryId])
  @@index([published, order])
}

// 购买链接（支持多平台）
model PurchaseLink {
  id        String   @id @default(cuid())
  platform  String   // 平台名称（如：天猫、京东、小红书、官方商城）
  url       String   // 购买链接
  order     Int      @default(0) // 排序
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    // 分类名称（中文）
  nameEn    String    // 分类名称（英文）
  slug      String    @unique // URL 标识
  icon      String?   @db.Text // 分类图标（SVG 代码）
  order     Int       @default(0) // 排序
  products  Product[] // 关联产品
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Image {
  id        String   @id @default(cuid())
  url       String   // 图片路径
  alt       String?  // 替代文本
  order     Int      @default(0) // 排序
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

// ============================================
// 内容管理
// ============================================

model Page {
  id              String   @id @default(cuid())
  title           String   // 页面标题
  slug            String   @unique // 页面标识 (home, story, ritual, contact, careers, privacy)
  content         Json     // 页面内容（结构化 JSON）
  seo             Json?    // SEO 配置
  backgroundImage String?  // 页面背景图片 URL
  published       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String   // 原始文件名
  url       String   // 存储路径
  type      String   // MIME 类型
  size      Int      // 文件大小 (bytes)
  width     Int?     // 图片宽度
  height    Int?     // 图片高度
  alt       String?  // 替代文本
  createdAt DateTime @default(now())

  @@index([type])
}

// ============================================
// 职位管理
// ============================================

model Job {
  id           String   @id @default(cuid())
  title        String   // 职位名称（中文）
  titleEn      String   // 职位名称（英文）
  location     String   // 工作地点
  type         String   // 职位类型 (fulltime, parttime, intern)
  description  String   @db.Text // 职责描述
  requirements String   @db.Text // 任职要求
  salary       String?  // 薪资范围（可选）
  order        Int      @default(0) // 排序
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications JobApplication[] // 该职位的申请记录

  @@index([published, order])
}

// ============================================
// 职位申请
// ============================================

model JobApplication {
  id         String   @id @default(cuid())
  jobId      String   // 申请的职位ID
  name       String   // 申请人姓名
  phone      String   // 手机号
  email      String   // 邮箱
  resumePath String   // 简历文件路径
  status     String   @default("pending") // 状态: pending, reviewed, interviewed, rejected, hired
  notes      String?  @db.Text // 备注
  folderId   String?  // 分类夹ID（可选）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  job    Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  folder ApplicationFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([folderId])
}

// ============================================
// 申请分类夹
// ============================================

model ApplicationFolder {
  id           String   @id @default(cuid())
  name         String   // 分类夹名称
  description  String?  // 描述说明
  order        Int      @default(0) // 排序
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications JobApplication[] // 该分类夹下的申请

  @@index([order])
}


// ============================================
// 联系留言
// ============================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String   // 留言人姓名
  email     String   // 邮箱
  content   String   @db.Text // 留言内容
  read      Boolean  @default(false) // 是否已读
  createdAt DateTime @default(now())

  @@index([read, createdAt(sort: Desc)])
}

// ============================================
// AI 护肤顾问
// ============================================

model AdvisorQuestion {
  id        String   @id @default(cuid())
  question  String   // 问题内容
  fieldName String   // 字段名 (skinType, concern, sleep, environment, routine, preference)
  type      String   @default("single") // 选择类型 (single, multiple)
  options   Json     // 选项列表 [{ value: 'dry', label: '干性肌肤', labelEn: 'Dry' }]
  order     Int      @default(0) // 排序
  active    Boolean  @default(true) // 是否启用
  gender    String   @default("all") // 性别过滤: male(男性), female(女性), all(全部)
  updatedAt DateTime @updatedAt

  @@unique([fieldName])
  @@index([active, order])
  @@index([gender])
}

model RecommendationRule {
  id         String   @id @default(cuid())
  conditions Json     // 条件组合 { skinType: ['dry'], concern: ['aging'] }
  productIds String[] // 推荐产品 ID 列表
  priority   Int      @default(0) // 优先级（数字越大越优先）
  message    String?  @db.Text // 推荐语
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([priority(sort: Desc)])
}

// AI 顾问用户行为分析
model AdvisorSession {
  id              String    @id @default(cuid())
  sessionId       String    @unique // 前端生成的会话ID

  // 用户标识（匿名）
  fingerprint     String?   // 浏览器指纹（可选）
  userAgent       String?   // 用户代理
  ip              String?   // IP地址
  province        String?   // 省份（如：广东、北京）
  city            String?   // 城市（如：深圳、朝阳）

  // 流程状态
  startedAt       DateTime  @default(now()) // 开始时间
  completedAt     DateTime? // 完成时间（到达结果页）

  // 问卷数据
  questionnaireStartedAt  DateTime? // 开始答题时间
  questionnaireCompletedAt DateTime? // 完成答题时间
  answers         Json?     // 问卷答案 { skinType, primaryConcern, ... }

  // 面部扫描
  faceScanStartedAt DateTime? // 开始面扫时间
  faceScanCompletedAt DateTime? // 完成面扫时间
  faceScanSkipped Boolean   @default(false) // 是否跳过
  faceScanUsed    Boolean   @default(false) // 是否使用了面部扫描

  // 分析结果
  analysisStartedAt DateTime? // 开始分析时间
  analysisCompletedAt DateTime? // 分析完成时间
  analysisSource  String?   // 分析来源: ai | fallback

  // 结果页行为
  resultViewedAt  DateTime? // 查看结果时间
  resultShared    Boolean   @default(false) // 是否分享
  shareMethod     String?   // 分享方式: image | link | weibo

  // 来源追踪
  referrer        String?   // 来源页面
  utmSource       String?   // UTM来源
  utmMedium       String?   // UTM媒介
  utmCampaign     String?   // UTM活动

  // 设备信息
  deviceType      String?   // desktop | mobile | tablet
  browser         String?   // 浏览器类型
  os              String?   // 操作系统

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
  @@index([faceScanSkipped])
  @@index([analysisSource])
  @@index([province])
}

// 每日统计汇总（用于快速查询）
model AdvisorDailyStats {
  id              String   @id @default(cuid())
  date            DateTime @db.Date @unique // 统计日期

  // 访问量
  totalSessions   Int      @default(0) // 总会话数
  uniqueVisitors  Int      @default(0) // 独立访客数（按指纹去重）

  // 漏斗数据
  startedQuestionnaire  Int @default(0) // 开始问卷
  completedQuestionnaire Int @default(0) // 完成问卷
  startedFaceScan      Int @default(0) // 开始面扫
  completedFaceScan    Int @default(0) // 完成面扫
  skippedFaceScan      Int @default(0) // 跳过面扫
  completedAnalysis    Int @default(0) // 完成分析
  viewedResult         Int @default(0) // 查看结果
  sharedResult         Int @default(0) // 分享结果

  // AI使用情况
  aiAnalysisCount      Int @default(0) // AI分析次数
  fallbackAnalysisCount Int @default(0) // 降级分析次数

  // 问卷答案分布（JSON存储）
  answerDistribution   Json? // { skinType: { dry: 10, oily: 20 }, ... }

  // 设备分布
  deviceDistribution   Json? // { desktop: 50, mobile: 40, tablet: 10 }

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
}

// ============================================
// 抽奖裂变
// ============================================

// 抽奖活动
model LotteryActivity {
  id          String   @id @default(cuid())
  name        String   // 活动名称
  description String?  @db.Text // 活动描述

  // 奖品信息
  prizeName   String   // 奖品名称
  prizeImage  String?  // 奖品图片
  prizeCount  Int      @default(1) // 奖品数量（中奖名额）

  // 时间设置
  startTime   DateTime // 活动开始时间
  endTime     DateTime // 活动结束时间（报名截止）
  drawTime    DateTime // 开奖时间

  // 规则设置
  rules       Json?    // 活动规则 { ipLimit: 3, deviceLimit: 1, ... }

  // 状态
  status      String   @default("draft") // draft | active | drawing | finished | cancelled

  // 开奖结果
  drawnAt     DateTime? // 实际开奖时间

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries     LotteryEntry[] // 参与记录

  @@index([status, startTime])
  @@index([drawTime])
}

// 抽奖参与记录
model LotteryEntry {
  id          String   @id @default(cuid())
  activityId  String   // 关联活动

  // 用户信息
  phone       String   // 手机号（加密存储）
  phoneHash   String   // 手机号哈希（用于去重和查询）

  // 花朵/签名图片
  drawingUrl  String   // 画作图片 URL（花朵或签名）
  drawingType String   @default("flower") // flower | signature

  // 花朵数据（用于花园展示）
  flowerData  Json?    // { colors: string[], strokeCount, duration, centerX, centerY, scale, rotation }

  // 来源追踪
  sessionId   String?  // 关联的 AdvisorSession

  // 邀请裂变
  inviteCode  String   @unique @default(cuid()) // 用户专属邀请码
  invitedBy   String?  // 被谁邀请的（邀请者的 inviteCode）
  inviteCount Int      @default(0) // 成功邀请人数
  bonusWeight Int      @default(0) // 中奖权重加成（每邀请1人 +10）

  // 风控数据
  ip          String   // IP 地址
  deviceId    String   // 设备指纹
  riskScore   Int      @default(0) // 风险评分 0-100
  riskFactors String[] // 风险因素 ["虚拟号段", "同IP多次"]

  // 绘制分析（兼容旧字段）
  signatureData Json?  // { strokeCount, duration, complexity }

  // 状态
  status      String   @default("pending") // pending | won | verified | expired | invalid

  // 中奖相关
  wonAt       DateTime? // 中奖时间
  wonRank     Int?      // 中奖顺序（第几个中奖）

  // 验证相关
  verifyCode  String?   // 验证码（加密）
  verifyCodeSentAt DateTime? // 验证码发送时间
  verifyAttempts Int    @default(0) // 验证尝试次数
  verifiedAt  DateTime? // 验证通过时间

  // 领奖信息
  recipientName    String? // 收件人姓名
  recipientPhone   String? // 收件人电话
  recipientAddress String? @db.Text // 收件地址
  shippedAt   DateTime? // 发货时间
  trackingNo  String?   // 快递单号

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activity    LotteryActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, phoneHash]) // 同一活动同一手机号只能参与一次
  @@index([activityId, status])
  @@index([activityId, riskScore])
  @@index([phoneHash])
  @@index([deviceId])
  @@index([invitedBy]) // 查询某人邀请了谁
}

// ============================================
// C端用户系统
// ============================================

model User {
  id            String    @id @default(cuid())
  phone         String    @unique              // 手机号（唯一）
  phoneVerified Boolean   @default(false)      // 手机验证状态
  password      String?                        // 密码（哈希后）
  nickname      String?                        // 昵称
  avatar        String?                        // 头像 URL

  // 微信登录
  wechatOpenId  String?   @unique              // 微信 OpenID
  wechatUnionId String?                        // 微信 UnionID

  // 点数
  points        Int       @default(0)          // 当前点数
  totalPoints   Int       @default(0)          // 累计获得

  // 关联
  addresses     Address[]
  orders        Order[]
  cartItems     CartItem[]
  pointRecords  PointRecord[]
  conversations AdvisorConversation[]
  userCoupons   UserCoupon[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([phone])
  @@index([wechatOpenId])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  name        String                           // 收件人
  phone       String                           // 联系电话
  province    String                           // 省
  city        String                           // 市
  district    String                           // 区
  detail      String                           // 详细地址
  postalCode  String?                          // 邮编
  isDefault   Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model SmsCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  type      String   @default("login")         // login | bind | reset
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, type])
  @@index([expiresAt])
}

// ============================================
// 点数系统
// ============================================

model PointRecord {
  id          String    @id @default(cuid())
  userId      String
  type        PointType
  amount      Int                              // 正数增加，负数减少
  balance     Int                              // 变动后余额
  description String
  relatedId   String?                          // 关联订单/对话ID

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
}

enum PointType {
  REGISTER_BONUS        // 注册奖励
  QUESTIONNAIRE_BONUS   // 完成问卷
  PURCHASE_REWARD       // 购买奖励
  SHARE_REWARD          // 分享奖励
  AI_CHAT_CONSUME       // AI追问消耗
  ADMIN_ADJUST          // 管理员调整
}

// ============================================
// AI 追问对话系统
// ============================================

model AdvisorConversation {
  id              String    @id @default(cuid())
  userId          String
  sessionId       String?                      // 关联原始 AdvisorSession
  analysisResult  Json?                        // 分析结果快照
  messageCount    Int       @default(0)
  pointsConsumed  Int       @default(0)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        ConversationMessage[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String                        // user | assistant
  content        String   @db.Text
  pointsCost     Int      @default(0)

  conversation   AdvisorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ============================================
// 购物车
// ============================================

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

// ============================================
// 订单系统
// ============================================

model Order {
  id             String      @id @default(cuid())
  orderNo        String      @unique           // 订单号
  userId         String

  // 金额
  totalAmount    Decimal     @db.Decimal(10, 2)
  shippingFee    Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  payAmount      Decimal     @db.Decimal(10, 2)

  // 收货信息快照
  recipientName    String
  recipientPhone   String
  recipientAddress String    @db.Text

  // 状态
  status         OrderStatus @default(PENDING)

  // 支付
  paymentMethod  String?                       // wechat | alipay
  paymentTime    DateTime?
  paymentNo      String?

  // 物流
  shippingCompany String?
  trackingNo      String?
  shippedAt       DateTime?
  receivedAt      DateTime?

  // 点数
  pointsEarned   Int         @default(0)

  // 备注
  remark         String?     @db.Text
  adminNote      String?     @db.Text

  user           User        @relation(fields: [userId], references: [id])
  items          OrderItem[]
  userCoupon     UserCoupon?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([orderNo])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  productName  String                          // 快照
  productImage String?
  price        Decimal  @db.Decimal(10, 2)
  quantity     Int
  subtotal     Decimal  @db.Decimal(10, 2)

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum OrderStatus {
  PENDING      // 待支付
  PAID         // 已支付
  PROCESSING   // 处理中
  SHIPPED      // 已发货
  DELIVERED    // 已签收
  COMPLETED    // 已完成
  CANCELLED    // 已取消
  REFUNDING    // 退款中
  REFUNDED     // 已退款
}

// ============================================
// 系统管理
// ============================================

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique // 登录邮箱
  password  String   // 加密密码
  name      String   // 显示名称
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique // 设置键名
  value     Json     // 设置值
  updatedAt DateTime @updatedAt
}

// ============================================
// 分享有礼
// ============================================

model ShareRewardCampaign {
  id                  String   @id @default(cuid())
  name                String   // 活动名称
  description         String?  @db.Text // 活动规则描述
  
  // 时间设置
  startDate           DateTime // 活动开始
  endDate             DateTime // 活动结束
  purchaseStartDate   DateTime // 购买凭证起始日期
  purchaseEndDate     DateTime // 购买凭证截止日期
  
  // 奖励设置
  rewardType          String   // coupon | sample
  rewardDescription   String   // 奖励描述
  
  // 海报配置
  posterTemplate      String?  // 海报模板图片URL
  posterConfig        Json?    // 填充配置 { score: {x,y,fontSize,color}, percentile: {...}, code: {...} }
  
  // 状态
  isActive            Boolean  @default(false)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  submissions         ShareRewardSubmission[]
  
  @@index([isActive, startDate])
}

model ShareRewardSubmission {
  id               String   @id @default(cuid())
  campaignId       String
  
  // 用户联系方式
  contact          String   // 手机号或邮箱
  
  // 凭证截图
  shareProofUrl    String   // 分享凭证截图
  purchaseProofUrl String   // 购买凭证截图
  
  // 用户分析数据（生成海报用）
  skinScore        Int?     // 肌肤评分
  percentile       Int?     // 超越比例
  
  // 审核状态
  status           String   @default("pending") // pending | approved | rejected
  rejectReason     String?
  
  // 发货状态
  shippingStatus   String   @default("none") // none | contacted | shipped
  
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  
  campaign         ShareRewardCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  @@unique([campaignId, contact]) // 同一活动同一联系方式只能提交一次
  @@index([campaignId, status])
  @@index([contact])
}

// ============================================
// 优惠券系统
// ============================================

model Coupon {
  id          String   @id @default(cuid())
  code        String?  @unique // 兑换码 (可选，为空时点击领取)
  name        String   // 优惠券名称
  type        String   // DISCOUNT_AMOUNT (满减) | DISCOUNT_PERCENT (折扣)
  value       Decimal  @db.Decimal(10, 2)
  minAmount   Decimal  @default(0) @db.Decimal(10, 2)
  
  // 有效期规则
  startDate   DateTime? // 固定开始时间
  endDate     DateTime? // 固定结束时间
  daysValid   Int?      // 领取后多少天有效 (相对时间)
  
  // 发放规则
  totalLimit  Int?      // 总发行量
  userLimit   Int       @default(1) // 每人限领张数
  
  isActive    Boolean   @default(true) // 上下架
  createdAt   DateTime  @default(now())
  
  userCoupons UserCoupon[]
}

model UserCoupon {
  id        String    @id @default(cuid())
  userId    String
  couponId  String
  
  status    String    // UNUSED (未使用), USED (已使用), EXPIRED (已过期), LOCKED (下单锁定)
  
  acquiredAt DateTime @default(now()) // 领取时间
  expiresAt  DateTime // 过期时间
  usedAt     DateTime? // 使用时间
  
  // 关联
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?  @unique
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
}
