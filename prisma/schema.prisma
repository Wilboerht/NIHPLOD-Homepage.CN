// Prisma Schema 定义
// 文档: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 产品相关
// ============================================

model Product {
  id            String         @id @default(cuid())
  name          String         // 产品名称（中文）
  nameEn        String         // 产品名称（英文）
  slug          String         @unique // URL 标识
  description   String         @db.Text // 产品描述
  price         Decimal        @db.Decimal(10, 2) // 参考价格
  capacity      String?        // 规格容量
  purchaseUrl   String?        // 外部购买链接（保留兼容，deprecated）
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  images        Image[]        // 产品图片
  purchaseLinks PurchaseLink[] // 多平台购买链接
  ingredients   String?        @db.Text // 成分说明
  usage         String?        @db.Text // 使用方法
  benefits      String[]       // 功效标签
  order         Int            @default(0) // 排序（数字越小越靠前）
  featured      Boolean        @default(false) // 是否推荐
  published     Boolean        @default(false) // 是否发布
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([published, order])
}

// 购买链接（支持多平台）
model PurchaseLink {
  id        String   @id @default(cuid())
  platform  String   // 平台名称（如：天猫、京东、小红书、官方商城）
  url       String   // 购买链接
  order     Int      @default(0) // 排序
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    // 分类名称（中文）
  nameEn    String    // 分类名称（英文）
  slug      String    @unique // URL 标识
  icon      String?   @db.Text // 分类图标（SVG 代码）
  order     Int       @default(0) // 排序
  products  Product[] // 关联产品
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Image {
  id        String   @id @default(cuid())
  url       String   // 图片路径
  alt       String?  // 替代文本
  order     Int      @default(0) // 排序
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

// ============================================
// 内容管理
// ============================================

model Page {
  id        String   @id @default(cuid())
  title     String   // 页面标题
  slug      String   @unique // 页面标识 (home, story, ritual, contact, careers, privacy)
  content   Json     // 页面内容（结构化 JSON）
  seo       Json?    // SEO 配置
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String   // 原始文件名
  url       String   // 存储路径
  type      String   // MIME 类型
  size      Int      // 文件大小 (bytes)
  width     Int?     // 图片宽度
  height    Int?     // 图片高度
  alt       String?  // 替代文本
  createdAt DateTime @default(now())

  @@index([type])
}

// ============================================
// 职位管理
// ============================================

model Job {
  id           String   @id @default(cuid())
  title        String   // 职位名称（中文）
  titleEn      String   // 职位名称（英文）
  location     String   // 工作地点
  type         String   // 职位类型 (fulltime, parttime, intern)
  description  String   @db.Text // 职责描述
  requirements String   @db.Text // 任职要求
  salary       String?  // 薪资范围（可选）
  order        Int      @default(0) // 排序
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications JobApplication[] // 该职位的申请记录

  @@index([published, order])
}

// ============================================
// 职位申请
// ============================================

model JobApplication {
  id         String   @id @default(cuid())
  jobId      String   // 申请的职位ID
  name       String   // 申请人姓名
  phone      String   // 手机号
  email      String   // 邮箱
  resumePath String   // 简历文件路径
  status     String   @default("pending") // 状态: pending, reviewed, interviewed, rejected, hired
  notes      String?  @db.Text // 备注
  folderId   String?  // 分类夹ID（可选）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  job    Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  folder ApplicationFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([folderId])
}

// ============================================
// 申请分类夹
// ============================================

model ApplicationFolder {
  id           String   @id @default(cuid())
  name         String   // 分类夹名称
  description  String?  // 描述说明
  order        Int      @default(0) // 排序
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications JobApplication[] // 该分类夹下的申请

  @@index([order])
}


// ============================================
// 联系留言
// ============================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String   // 留言人姓名
  email     String   // 邮箱
  content   String   @db.Text // 留言内容
  read      Boolean  @default(false) // 是否已读
  createdAt DateTime @default(now())

  @@index([read, createdAt(sort: Desc)])
}

// ============================================
// AI 护肤顾问
// ============================================

model AdvisorQuestion {
  id        String   @id @default(cuid())
  question  String   // 问题内容
  fieldName String   // 字段名 (skinType, concern, sleep, environment, routine, preference)
  type      String   @default("single") // 选择类型 (single, multiple)
  options   Json     // 选项列表 [{ value: 'dry', label: '干性肌肤', labelEn: 'Dry' }]
  order     Int      @default(0) // 排序
  active    Boolean  @default(true) // 是否启用
  updatedAt DateTime @updatedAt

  @@unique([fieldName])
  @@index([active, order])
}

model RecommendationRule {
  id         String   @id @default(cuid())
  conditions Json     // 条件组合 { skinType: ['dry'], concern: ['aging'] }
  productIds String[] // 推荐产品 ID 列表
  priority   Int      @default(0) // 优先级（数字越大越优先）
  message    String?  @db.Text // 推荐语
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([priority(sort: Desc)])
}

// AI 顾问用户行为分析
model AdvisorSession {
  id              String    @id @default(cuid())
  sessionId       String    @unique // 前端生成的会话ID

  // 用户标识（匿名）
  fingerprint     String?   // 浏览器指纹（可选）
  userAgent       String?   // 用户代理
  ip              String?   // IP地址（脱敏存储）

  // 流程状态
  startedAt       DateTime  @default(now()) // 开始时间
  completedAt     DateTime? // 完成时间（到达结果页）

  // 问卷数据
  questionnaireStartedAt  DateTime? // 开始答题时间
  questionnaireCompletedAt DateTime? // 完成答题时间
  answers         Json?     // 问卷答案 { skinType, primaryConcern, ... }

  // 面部扫描
  faceScanStartedAt DateTime? // 开始面扫时间
  faceScanCompletedAt DateTime? // 完成面扫时间
  faceScanSkipped Boolean   @default(false) // 是否跳过
  faceScanUsed    Boolean   @default(false) // 是否使用了面部扫描

  // 分析结果
  analysisStartedAt DateTime? // 开始分析时间
  analysisCompletedAt DateTime? // 分析完成时间
  analysisSource  String?   // 分析来源: ai | fallback

  // 结果页行为
  resultViewedAt  DateTime? // 查看结果时间
  resultShared    Boolean   @default(false) // 是否分享
  shareMethod     String?   // 分享方式: image | link | weibo

  // 来源追踪
  referrer        String?   // 来源页面
  utmSource       String?   // UTM来源
  utmMedium       String?   // UTM媒介
  utmCampaign     String?   // UTM活动

  // 设备信息
  deviceType      String?   // desktop | mobile | tablet
  browser         String?   // 浏览器类型
  os              String?   // 操作系统

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([createdAt])
  @@index([faceScanSkipped])
  @@index([analysisSource])
}

// 每日统计汇总（用于快速查询）
model AdvisorDailyStats {
  id              String   @id @default(cuid())
  date            DateTime @db.Date @unique // 统计日期

  // 访问量
  totalSessions   Int      @default(0) // 总会话数
  uniqueVisitors  Int      @default(0) // 独立访客数（按指纹去重）

  // 漏斗数据
  startedQuestionnaire  Int @default(0) // 开始问卷
  completedQuestionnaire Int @default(0) // 完成问卷
  startedFaceScan      Int @default(0) // 开始面扫
  completedFaceScan    Int @default(0) // 完成面扫
  skippedFaceScan      Int @default(0) // 跳过面扫
  completedAnalysis    Int @default(0) // 完成分析
  viewedResult         Int @default(0) // 查看结果
  sharedResult         Int @default(0) // 分享结果

  // AI使用情况
  aiAnalysisCount      Int @default(0) // AI分析次数
  fallbackAnalysisCount Int @default(0) // 降级分析次数

  // 问卷答案分布（JSON存储）
  answerDistribution   Json? // { skinType: { dry: 10, oily: 20 }, ... }

  // 设备分布
  deviceDistribution   Json? // { desktop: 50, mobile: 40, tablet: 10 }

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
}

// ============================================
// 系统管理
// ============================================

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique // 登录邮箱
  password  String   // 加密密码
  name      String   // 显示名称
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique // 设置键名
  value     Json     // 设置值
  updatedAt DateTime @updatedAt
}
