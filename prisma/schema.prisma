// Prisma Schema 定义
// 文档: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 产品相关
// ============================================

model Product {
  id            String         @id @default(cuid())
  name          String         // 产品名称（中文）
  nameEn        String         // 产品名称（英文）
  slug          String         @unique // URL 标识
  description   String         @db.Text // 产品描述
  price         Decimal        @db.Decimal(10, 2) // 参考价格
  capacity      String?        // 规格容量
  purchaseUrl   String?        // 外部购买链接（保留兼容，deprecated）
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  images        Image[]        // 产品图片
  purchaseLinks PurchaseLink[] // 多平台购买链接
  ingredients   String?        @db.Text // 成分说明
  usage         String?        @db.Text // 使用方法
  benefits      String[]       // 功效标签
  origin        String?        // 产地
  order         Int            @default(0) // 排序（数字越小越靠前）
  featured      Boolean        @default(false) // 是否推荐
  published     Boolean        @default(false) // 是否发布
  // 站内购买设置
  allowDirectBuy Boolean       @default(false) // 是否允许站内购买
  stock          Int           @default(0) // 库存数量
  salesCount     Int           @default(0) // 销量统计
  cartItems      CartItem[]    // 关联购物车
  orderItems     OrderItem[]   // 关联订单项
  geoFaqs        Json?         // AI 生成的 GEO FAQ 数据
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([categoryId])
  @@index([published, order])
  @@index([featured, order])
}

// 购买链接（支持多平台）
model PurchaseLink {
  id        String   @id @default(cuid())
  platform  String   // 平台名称（如：天猫、京东、小红书、官方商城）
  url       String   // 购买链接
  order     Int      @default(0) // 排序
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productId])
}

model Category {
  id        String    @id @default(cuid())
  name      String    // 分类名称（中文）
  nameEn    String    // 分类名称（英文）
  slug      String    @unique // URL 标识
  icon      String?   @db.Text // 分类图标（SVG 代码）
  order     Int       @default(0) // 排序
  visible   Boolean   @default(true) // 是否在前台展示
  products  Product[] // 关联产品
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([visible, order])
}

model Image {
  id        String   @id @default(cuid())
  url       String   // 图片路径
  alt       String?  // 替代文本
  order     Int      @default(0) // 排序
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productId])
}




// ============================================
// 职位管理
// ============================================

model Job {
  id           String   @id @default(cuid())
  title        String   // 职位名称（中文）
  titleEn      String?  // 职位名称（英文）
  location     String   // 工作地点
  type         String   // 职位类型 (fulltime, parttime, intern)
  description  String   @db.Text // 职责描述
  requirements String   @db.Text // 任职要求
  salary       String?  // 薪资范围（可选）
  longitude    Float?   // 经度
  latitude     Float?   // 纬度
  order        Int      @default(0) // 排序
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  applications JobApplication[] // 该职位的申请记录

  @@index([published, order])
}

// ============================================
// 职位申请
// ============================================

model JobApplication {
  id         String   @id @default(cuid())
  jobId      String   // 申请的职位ID
  name       String   // 申请人姓名
  phone      String   // 手机号
  resumePath String   // 简历文件路径
  status     String   @default("pending") // 状态: pending, reviewed, interviewed, rejected, hired
  notes      String?  @db.Text // 备注
  folderId   String?  // 分类夹ID（可选）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  job    Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  folder ApplicationFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([folderId])
}

// ============================================
// 申请分类夹
// ============================================

model ApplicationFolder {
  id           String   @id @default(cuid())
  name         String   // 分类夹名称
  description  String?  // 描述说明
  order        Int      @default(0) // 排序
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  applications JobApplication[] // 该分类夹下的申请

  @@index([order])
}


// ============================================
// 联系留言
// ============================================

model ContactMessage {
  id        String   @id @default(cuid())
  name      String   // 留言人姓名
  phone     String   // 联系电话
  type      String?  // 留言类型 (咨询、合作等)
  content   String   @db.Text // 留言内容
  read      Boolean  @default(false) // 是否已读
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([read, createdAt(sort: Desc)])
}




// ============================================
// C端用户系统
// ============================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum MembershipLevel {
  SILVER
  GOLD
  DIAMOND
}

model User {
  id            String     @id @default(cuid())
  phone         String     @unique              // 手机号（唯一）
  phoneVerified Boolean    @default(false)      // 手机验证状态
  password      String?                         // 密码（哈希后）
  nickname      String?                         // 昵称
  avatar        String?                         // 头像 URL
  status        UserStatus @default(ACTIVE)     // 账号状态

  // 密码策略
  passwordChangedAt DateTime?                   // 上次密码修改时间
  passwordExpiresAt DateTime?                   // 密码过期时间（null 表示未启用过期策略）

  // 多租户预留：如需租户隔离，添加 tenantId String? 字段，并在所有查询中添加 WHERE tenantId = ? 条件

  // 微信登录
  wechatOpenId  String?   @unique               // 微信 OpenID
  wechatUnionId String?                         // 微信 UnionID

  // VIP 会员
  membershipLevel MembershipLevel @default(SILVER)
  totalPoints     Int              @default(0)
  birthday        DateTime?

  // 关联
  addresses        Address[]
  orders           Order[]
  cartItems        CartItem[]
  userCoupons      UserCoupon[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  pointTransactions PointTransaction[]
  passwordHistory  PasswordHistory[] @relation("UserPasswordHistory")

  oauthCodes    OAuthAuthorizationCode[] @relation("OAuthCodeUser")
  oauthSessions OAuthSession[]           @relation("OAuthSessionUser")
  oauthConsents UserConsent[]            @relation("UserConsentUser")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([membershipLevel])
  @@index([wechatUnionId])
  // phone 和 wechatOpenId 已有 @unique 索引，无需重复 @@index
  @@index([passwordExpiresAt])
}

// ============================================
// 用户认证增强
// ============================================

/**
 * Refresh Token 存储
 * 用于实现 Token 刷新机制
 */
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  clientId  String?                               // OAuth client_id（OAuth 刷新令牌使用）
  token     String   @db.Text                      // 加密后的 refresh token
  expiresAt DateTime                               // 过期时间
  revokedAt DateTime?                              // 撤销时间（已登出）

  // 设备/会话信息
  deviceName  String?  // 设备名称/浏览器摘要
  deviceInfo  String?  // 原始 UA 摘要
  ipAddress   String?  // 登录 IP
  userAgent   String?  @db.Text

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, expiresAt])
  @@index([token])
  @@index([userId, revokedAt, expiresAt])
  @@index([userId, clientId, revokedAt, expiresAt])
  @@index([expiresAt])
}

/**
 * 登录尝试记录
 * 用于防止账户爆破和跟踪异常登录
 * 覆盖 C端用户（password/sms）和管理员（admin）登录
 */
model LoginAttempt {
  id        String   @id @default(cuid())
  identifier String                            // 登录标识：手机号（C 端）或邮箱（管理员）
  type      String   @default("password")      // password | sms | admin — 应用层 Zod 约束，未用 Prisma enum 因保持灵活
  success   Boolean                            // 是否成功
  reason    String?                            // 失败原因（如：code_invalid、user_not_found 等）
  ipAddress String?                            // IP 地址
  userAgent String?  @db.Text                  // User Agent
  clientId  String?                            // OAuth Client ID（来源子项目）
  
  createdAt DateTime @default(now())
  
  @@index([identifier, createdAt(sort: Desc)])
  @@index([identifier, success, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
}

/**
 * 密码历史
 * 记录用户最近 N 个密码哈希，用于防止重复使用历史密码。
 * 应用层负责限制历史数量（默认 5 条）。
 */
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  password  String   // 密码哈希（bcrypt）
  createdAt DateTime @default(now())

  user User @relation("UserPasswordHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ============================================
// OAuth 2.0 / SSO 一网通
// ============================================

model OAuthClient {
  id                  String   @id @default(cuid())
  clientId            String   @unique     // 客户端 ID（公开）
  clientSecret        String               // 客户端密钥（bcrypt 哈希存储）
  name                String               // 应用名称
  redirectUris        String[]             // 允许的回调 URL 列表
  postLogoutRedirectUris String[]            // 允许的 RP-Initiated Logout 返回地址
  scopes              String[]             // 允许的权限范围
  isActive            Boolean  @default(true)
  isPublic            Boolean  @default(false)  // Public Client (SPA/移动端/桌面端不传 client_secret)
  backchannelLogoutUri String?            // Backchannel Logout URI
  codeTtlSeconds      Int      @default(300)    // 授权码有效期（秒），默认 5 分钟
  accessTokenTtlSeconds Int    @default(900)    // Access Token 有效期（秒），默认 15 分钟
  tenantId            String?              // 多租户预留：当前为 null 表示全局共享
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  authorizationCodes OAuthAuthorizationCode[] @relation("OAuthCodeClient")
  sessions           OAuthSession[]          @relation("OAuthSessionClient")
  consents           UserConsent[]           @relation("UserConsentClient")

  @@index([isActive])
  @@index([tenantId])
}

model OAuthAuthorizationCode {
  id                  String    @id @default(cuid())
  code                String    @unique     // 授权码（SHA-256 哈希存储）
  clientId            String                // 关联的 OAuthClient.clientId
  userId              String                // 关联的用户 ID
  redirectUri         String                // 回调 URL 快照
  scopes              String[]              // 请求的权限范围
  codeChallenge       String?               // PKCE code_challenge
  codeChallengeMethod String?               // PKCE method（S256）
  nonce               String?               // OIDC nonce（防重放）
  expiresAt           DateTime              // 过期时间（5 分钟）
  used                Boolean   @default(false)
  createdAt           DateTime  @default(now())

  client OAuthClient @relation("OAuthCodeClient", fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation("OAuthCodeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([clientId, used, expiresAt])
}

model OAuthSession {
  id                   String    @id @default(cuid())
  userId               String
  clientId             String
  sessionId            String    @unique
  authorizationCodeId  String?   // 关联的授权码（用于追溯）。无 FK 约束：授权码定期清理，需保留 session 记录
  scopes               String[]
  createdAt            DateTime  @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?

  client OAuthClient @relation("OAuthSessionClient", fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation("OAuthSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clientId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([clientId])
}

model UserConsent {
  id        String    @id @default(cuid())
  userId    String
  clientId  String
  scopes    String[]
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  client OAuthClient @relation("UserConsentClient", fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation("UserConsentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
}

model SsoAuditEvent {
  id         String   @id @default(cuid())
  event      String               // authorize | token | introspect | logout | userinfo | backchannel_logout | consent | status_change
  userId     String?              // 关联用户
  clientId   String?              // 关联子项目
  clientName String?              // 子项目名称快照
  ip         String?              // IP 地址
  userAgent  String?  @db.Text    // User Agent
  detail     Json?                // 事件详情
  success    Boolean  @default(true)
  tenantId   String?              // 多租户预留
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([event, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
}

model PaymentNotification {
  id               String            @id @default(cuid())
  gateway          String            // "wechat" 或 "alipay"
  notificationId   String            // 通知ID（微信: out_trade_no, 支付宝: trade_no）
  transactionId    String            // 交易ID（微信: transaction_id, 支付宝: trade_no）
  amount           Decimal           @db.Decimal(10, 2) // 金额（元），与 Order.payAmount 等单位一致
  status           String            @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED"
  rawData          String            @db.Text // 原始通知数据（JSON）
  errorMessage     String?           // 错误信息
  processedAt      DateTime?         // 处理时间
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  // 复合索引：确保同一个通知在同一个网关上只处理一次
  @@unique([gateway, notificationId])
  @@index([gateway, status])
  @@index([transactionId])
  @@index([createdAt])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  name        String                           // 收件人
  phone       String                           // 联系电话
  province    String                           // 省
  city        String                           // 市
  district    String                           // 区
  detail      String                           // 详细地址
  isDefault   Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([userId])
}

model SmsCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String   // 验证码 SHA-256 哈希
  type      String   @default("login")         // login | bind | reset
  used      Boolean  @default(false)
  ipAddress String?  // 发送时的客户端 IP（可选，用于 IP 绑定校验）
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, type])
  @@index([expiresAt])
  @@index([phone, used, expiresAt])

  // 注意：以下约束通过 raw SQL migration 实现（Prisma 不支持 partial unique index）：
  // migration 20260710100000_smscode_partial_unique_index
  // CREATE UNIQUE INDEX "SmsCode_phone_type_used_false_key" ON "SmsCode"("phone","type") WHERE "used" = false;
}



// ============================================
// 购物车
// ============================================

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

// ============================================
// 订单系统
// ============================================

model Order {
  id             String      @id @default(cuid())
  orderNo        String      @unique           // 订单号
  userId         String

  // 金额
  totalAmount    Decimal     @db.Decimal(10, 2)
  shippingFee    Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount Decimal     @default(0) @db.Decimal(10, 2)
  payAmount      Decimal     @db.Decimal(10, 2)

  // 收货信息快照
  recipientName    String
  recipientPhone   String
  recipientAddress String    @db.Text

  // 状态
  status         OrderStatus @default(PENDING)
  previousStatus OrderStatus? // 申请退款前的状态，用于拒绝退款后恢复

  // 支付
  paymentMethod  String?                       // wechat | alipay
  paymentTime    DateTime?
  paymentNo      String?

  // 退款
  refundNo       String?                       // 退款单号（微信/支付宝）
  refundAmount   Decimal?    @db.Decimal(10, 2) // 退款金额
  refundTime     DateTime?
  refundStatus   RefundStatus? // PENDING | SUCCESS | FAILED | CLOSED

  // 物流
  shippingCompany String?
  trackingNo      String?
  shippedAt       DateTime?
  receivedAt      DateTime?


  // 备注
  remark         String?     @db.Text
  adminNote      String?     @db.Text

  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  transactions   Transaction[] // 交易流水记录
  userCoupon     UserCoupon?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([paymentNo])
  @@index([status, shippedAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String
  productName  String                          // 快照
  productImage String?
  price        Decimal  @db.Decimal(10, 2)
  quantity     Int
  subtotal     Decimal  @db.Decimal(10, 2)

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ============================================
// 交易流水（支付/退款资金变动记录）
// ============================================

model Transaction {
  id              String   @id @default(cuid())
  orderId         String
  type            String   // PAYMENT | REFUND
  gateway         String   // wechat | alipay | mock
  amount          Decimal  @db.Decimal(10, 2)
  status          String   // SUCCESS | FAILED
  gatewayTrxId    String?  // 第三方交易流水号（如微信 transaction_id、支付宝 trade_no）
  gatewayRefundId String?  // 退款单号
  rawData         String?  @db.Text // 原始响应/通知数据（JSON）
  createdAt       DateTime @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([gatewayTrxId])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING      // 待支付
  PAYING       // 支付中（新增中间状态）
  PAID         // 已支付
  PROCESSING   // 处理中
  SHIPPED      // 已发货
  DELIVERED    // 已签收
  COMPLETED    // 已完成
  CANCELLED    // 已取消
  REFUNDING    // 退款中
  REFUNDED     // 已退款
}

enum RefundStatus {
  PENDING      // 退款待处理
  SUCCESS      // 退款成功
  FAILED       // 退款失败
  CLOSED       // 退款关闭
}

enum UserCouponStatus {
  UNUSED
  USED
  EXPIRED
  LOCKED
}

// ============================================
// 审计日志
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // 操作类型: ship_order, refund_order, create_admin, update_admin, delete_admin, login, logout 等
  targetType String  // 目标类型: order, admin, product, category, job, message, application 等
  targetId  String?  // 目标记录ID
  detail    Json?    // 操作详情（变更前后数据快照等）
  ipAddress String?  // 操作者IP
  userAgent String?  @db.Text // 浏览器UA
  adminId   String?
  userId    String?  // C 端用户事件使用
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([adminId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

// ============================================
// 限流记录（支持多实例部署）
// ============================================

model RateLimitRecord {
  id          String   @id @default(cuid())
  key         String   // 如 "login:192.168.1.1"
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([key, windowStart])
}

// ============================================
// VIP 会员体系
// ============================================

model PointTransaction {
  id        String   @id @default(cuid())
  userId    String
  points    Int      // 正数为获得，负数为消耗
  type      String   // ORDER_REWARD | BIRTHDAY_GIFT | ADMIN_ADJUST | REDEEM | LEVEL_UP_BONUS
  reference String?  // 关联的订单号/优惠券ID等
  note      String?  @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

model MembershipBenefit {
  id          String          @id @default(cuid())
  level       MembershipLevel @unique
  name        String          // 等级名称（如：银卡会员）
  nameEn      String?         // 英文名称
  icon        String?         // 图标 emoji/SVG
  minPoints   Int             // 升级所需最低积分
  maxPoints   Int?            // 该等级积分上限（最高等级为 null）
  pointRate   Int             @default(1) // 消费积分倍率（1元=N分）
  benefits    Json            // 权益列表 [{ icon, title, desc }]
  colorClass  String?         // Tailwind 颜色类名
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
}

// ============================================
// 系统管理
// ============================================

enum AdminRole {
  // 注意：AdminRole 与其他 enum 大小写不一致（lowercase vs UPPERCASE），
  // 由于已投入生产且有 DB 记录，保留当前值避免 breaking change
  owner
  admin
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

model Admin {
  id              String      @id @default(cuid())
  email           String      @unique // 登录邮箱
  password        String      // 加密密码
  name            String      // 显示名称
  role            AdminRole   @default(admin)
  status          AdminStatus @default(ACTIVE) // 账号状态
  deletedAt       DateTime?   // 软删除时间
  totpSecret      String?     // 加密后的 TOTP secret
  totpEnabled     Boolean     @default(false)
  totpBackupCodes String?     @db.Text // 加密存储的备用码 JSON 数组
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  auditLogs AuditLog[] // 审计日志关联

  @@index([status])
  @@index([deletedAt])
  @@index([role])
}

// 系统动态配置存储
// 当前用途：运费策略 (shipping_config)，支持后台动态调整运费模式、门槛和费率
// key: "shipping_config" | value: { mode, freeThreshold, baseFee }
// 注意：此表正在使用中，请勿删除
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique // 设置键名
  value     Json     // 设置值
  updatedAt DateTime @default(now()) @updatedAt
}



// ============================================
// 优惠券系统
// ============================================

model Coupon {
  id          String   @id @default(cuid())
  code        String?  @unique // 兑换码 (可选，为空时点击领取)
  name        String   // 优惠券名称
  type        String   // DISCOUNT_AMOUNT (满减) | DISCOUNT_PERCENT (折扣)
  value       Decimal  @db.Decimal(10, 2)
  minAmount   Decimal  @default(0) @db.Decimal(10, 2)

  // 有效期规则
  startDate   DateTime? // 固定开始时间
  endDate     DateTime? // 固定结束时间
  daysValid   Int?      // 领取后多少天有效 (相对时间)

  // 发放规则
  totalLimit  Int?      // 总发行量
  userLimit   Int       @default(1) // 每人限领张数

  // 适用范围
  scopeType   String    @default("ALL") // ALL | CATEGORY | PRODUCT
  scopeIds    String[]  @default([])    // 品类ID或商品ID列表

  isActive    Boolean   @default(true) // 上下架
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  userCoupons UserCoupon[]

  @@index([isActive])
  @@index([isActive, startDate, endDate])
}

model UserCoupon {
  id        String    @id @default(cuid())
  userId    String
  couponId  String
  
  status    UserCouponStatus @default(UNUSED)
  
  acquiredAt DateTime @default(now()) // 领取时间
  expiresAt  DateTime // 过期时间
  usedAt     DateTime? // 使用时间
  
  // 关联
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?  @unique
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, status])
  @@index([expiresAt])
}

// ============================================
// Token 黑名单（多实例共享）
// ============================================

enum TokenBlacklistType {
  access_token
  user
  logout_jti
  wechat_exchange_token
  internal_api_nonce
}

model TokenBlacklist {
  id        String              @id @default(cuid())
  type      TokenBlacklistType  // access_token: 单条 token 撤销; user: 用户全局拉黑
  key       String              @unique // jti 或 userId
  reason    String?             // 拉黑原因（仅 user 类型使用）
  expiresAt DateTime            // 自然过期时间，与 token 最大过期一致
  createdAt DateTime            @default(now())

  @@index([type])
  @@index([expiresAt])
}
