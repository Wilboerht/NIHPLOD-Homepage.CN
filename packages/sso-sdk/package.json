{
  "name": "@nihplod/sso-sdk",
  "version": "1.0.0",
  "description": "NIHPLOD 一网通 SSO Node.js SDK — 完整的 OAuth 2.0 客户端，含 Token 自动刷新、事件系统、降级策略",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sso",
    "oauth2",
    "oidc",
    "pkce",
    "token-management",
    "nihplod"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nihplod/nihplod.cn",
    "directory": "packages/sso-sdk"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
