# ===========================================
# NIHPLOD.CN 环境变量配置示例
# 复制此文件为 .env.local 并填写实际值
# ===========================================

# ----- 应用配置 -----
NEXT_PUBLIC_APP_NAME=NIHPLOD
# 应用的基础访问 URL (本地通常是 http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://nihplod.cn
# 站点地图和 SEO 使用的 URL
NEXT_PUBLIC_SITE_URL=https://nihplod.cn
NEXT_PUBLIC_APP_DESCRIPTION=逆转时光

# ----- SSO 账号嵌入 (/account/embed) -----
# 允许 iframe 嵌入 /account/embed 的父页面 origin（CSP frame-ancestors），逗号分隔，必须完整 origin
# 不配置时仅允许同源嵌入（frame-ancestors 'self'）
# EMBED_ALLOWED_ORIGINS=https://advisor.nihplod.cn,https://mall.nihplod.cn
# 与上方保持一致（客户端 postMessage targetOrigin 白名单）
# NEXT_PUBLIC_EMBED_ALLOWED_ORIGINS=https://advisor.nihplod.cn,https://mall.nihplod.cn

# ----- 数据库配置 (Prisma) -----
# 本地开发使用普通连接
DATABASE_URL="postgresql://username:password@localhost:5432/nihplod?schema=public"
# 生产环境连接字符串 (阿里云 RDS / 自建 PostgreSQL)
# DATABASE_URL="postgresql://user:pass@your-db-host:5432/nihplod?schema=public"
# 数据库最大连接数
DATABASE_MAX_CONNECTIONS=20
# 生产环境必须设置：数据库 SSL CA 证书路径（阿里云 RDS 等云数据库）
# DATABASE_SSL_CA=/path/to/rds-ca.pem

# ----- 认证配置 -----
# 重要: 如果有子站，JWT 相关密钥必须全站一致以支持单点登录
# 每类 Token 使用独立的 Secret，启动时若未配置将直接报错
# 
# ⚠️ 安全警告：以下密钥必须使用强随机字符串！
# 生成命令（Linux/macOS）：openssl rand -hex 32
# 生成命令（Windows PowerShell）：[System.Convert]::ToBase64String((New-Object System.Security.Cryptography.RNGCryptoServiceProvider).GetBytes(32))
# 严禁使用 "dev-*-secret-" 等可预测模式——这些仅在开发环境可用，生产环境必须替换
#
# JWT_ADMIN_SECRET=your-admin-jwt-secret-min-32-characters
# JWT_ACCESS_SECRET=your-user-access-jwt-secret-min-32-characters
# JWT_REFRESH_SECRET=your-user-refresh-jwt-secret-min-32-characters
# JWT_WECHAT_BIND_SECRET=your-wechat-bind-secret-min-32-characters
# JWT_WECHAT_EXCHANGE_SECRET=your-wechat-exchange-secret-min-32-characters
# JWT_ID_TOKEN_SECRET=your-id-token-secret-min-32-characters
# JWT_LOGOUT_SECRET=your-logout-secret-min-32-characters

# 登录尝试记录标识符 HMAC 密钥（必填，不少于 32 字符，启动时强制校验）
# LoginAttempt 表对手机号/邮箱做 HMAC-SHA256 后存储，防止拖库后用彩虹表还原明文手机号
# （手机号空间小，无盐 SHA-256 可被枚举还原）
# 生成命令（Linux/macOS）：openssl rand -hex 32
# 注意：启用或轮换此密钥后，历史登录尝试记录将无法匹配（登录记录时效短，7 天内自动清理，可接受）
# LOGIN_ATTEMPT_HMAC_KEY=your-login-attempt-hmac-key-min-32-characters

# 是否允许 OAuth Access Token / ID Token 在 RS256 验证失败后回退到 HS256（兼容旧 token）
# 生产环境必须设置为 false，并配置下方 RS256 密钥；仅在新旧密钥轮换过渡期临时启用
ALLOW_HS256_FALLBACK=false

# OAuth Access Token RS256 非对称密钥（生产环境必须配置）
# 生成命令：npx tsx scripts/generate-oauth-rs256-keys.ts
# 配置后 JWKS 端点将公开公钥，子项目可本地验证 access_token
# JWT_ACCESS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# OAuth ID Token RS256 非对称密钥（生产环境必须配置）
# 生成命令：npx tsx scripts/generate-oauth-rs256-keys.ts
# 配置后 JWKS 端点将公开 ID Token 公钥，Public Client 可本地验证 id_token 签名
# 注意：SDK 一律拒绝 HS256 签名的 id_token，未配置此密钥对时子项目回调会全部失败
# JWT_ID_TOKEN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_ID_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# === 密钥轮换（可选）===
# 轮换流程：1) 生成新密钥对并配置为上方当前密钥；2) 将旧公钥配置到下方 *_PREV_PUBLIC_KEY；
# 3) 待旧密钥签发的 token 全部过期后（access/id token 1 小时内），移除 *_PREV_* 配置。
# 过渡期内 JWKS 端点会同时暴露当前与上一代公钥，验证侧按 kid 匹配。
# kid 默认值：access-token-rs256-v1 / id-token-rs256-v1 / logout-token-rs256-v1（上一代默认 -v0）
# JWT_OAUTH_ACCESS_PREV_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_OAUTH_ID_TOKEN_PREV_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_LOGOUT_TOKEN_PREV_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_OAUTH_ACCESS_KID=access-token-rs256-v1
# JWT_OAUTH_ACCESS_PREV_KID=access-token-rs256-v0
# JWT_OAUTH_ID_TOKEN_KID=id-token-rs256-v1
# JWT_OAUTH_ID_TOKEN_PREV_KID=id-token-rs256-v0
# JWT_LOGOUT_TOKEN_KID=logout-token-rs256-v1
# JWT_LOGOUT_TOKEN_PREV_KID=logout-token-rs256-v0

# Backchannel Logout Token RS256 非对称密钥（生产环境必须配置）
# 生成命令：npx tsx scripts/generate-oauth-rs256-keys.ts（与上方密钥对一次生成）
# 用于主站向子项目推送登出通知时签发 logout token，子项目用公钥验签
# JWT_LOGOUT_TOKEN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_LOGOUT_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# === 账户状态变更 Webhook（可选）===
# 管理员封禁/解冻/删除用户时向下列 URL 推送 account_status_change 事件（逗号分隔）
# SSO_STATUS_CHANGE_WEBHOOK_URLS=https://sub1.example.com/webhook,https://sub2.example.com/webhook
# Webhook 请求签名密钥（HMAC-SHA256，请求头 X-Webhook-Signature: t=<ts>,v1=<hex>，签名串 <ts>.<body>）
# 未配置时通知不带签名，验签方法见 docs/sso-integration.md
# SSO_WEBHOOK_SECRET=

# 子站域名配置（用于微信授权完成后安全地重定向回子站，并生成一次性 exchange token）
# 示例：NEXT_PUBLIC_ADVISOR_URL=https://advisor.nihplod.cn
NEXT_PUBLIC_ADVISOR_URL=

# 内部 API 密钥（用于子站调用官网内部接口，如微信模板消息推送、微信授权兑换、积分同步）
#
# 新版（推荐）：按项目分发的多密钥 + HMAC-SHA256 签名，JSON 数组格式
# 子站调用 /api/v1/internal/* 时使用签名鉴权
# 生成命令：npx tsx scripts/generate-internal-api-keys.ts [project]
# ⚠️ 注意：每个 secret 必须是不少于 32 字节的强随机字符串（脚本生成的为 32 字节 base64），
#    下方仅为格式示例，长度不足，严禁直接用于任何环境
# ⚠️ 新增/修改条目后必须重启官网实例才生效（启动时解析缓存）
# 商城积分同步（/api/v1/internal/points/sync、/api/v1/internal/user/balance）使用 project=mall 的条目：
# INTERNAL_API_KEYS='[{"project":"advisor","key":"advisor-example-key","secret":"example-secret-replace-with-32-byte-random-value-from-script"},{"project":"mall","key":"mall-example-key","secret":"example-secret-replace-with-32-byte-random-value-from-script"}]'
INTERNAL_API_KEYS='[{"project":"advisor","key":"advisor-example-key","secret":"example-secret-replace-with-32-byte-random-value-from-script"}]'

# 微信公众号模板消息 ID（用于向用户推送测肤报告完成通知）
WECHAT_TEMPLATE_ID=
# 管理员 Token / Cookie 过期时间，默认 1d，格式：数字+单位（s/m/h/d）
JWT_EXPIRES_IN=1d

# TOTP 2FA 加密密钥（独立于 JWT_SECRET，避免轮换 JWT 时破坏已存储的 TOTP 密钥）
# 注意：JWT_SECRET 已废弃，此环境变量必须显式配置，不再回退
# 生成命令：openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@nihplod.cn
ADMIN_PASSWORD=your-secure-admin-password

# 种子数据配置（用于 prisma db seed）
# 方式一（推荐）：通过 JSON 数组配置多个管理员
# SEED_ADMINS=[{"email":"admin@nihplod.cn","password":"your-strong-random-password-min-12-chars","name":"System Admin","role":"owner"}]
#
# 方式二：配置单个管理员（兼容旧版）
# SEED_ADMIN_EMAIL=admin@nihplod.cn
# SEED_ADMIN_NAME=System Admin
# SEED_ADMIN_PASSWORD=your-strong-random-password-min-12-chars
#
# 注意：密码必须至少 12 位，且包含大小写字母和数字。
# 切勿将真实密码提交到代码仓库。

# 测试用户密码（可选，不设置则跳过创建测试用户）
SEED_TEST_USER_PASSWORD=your-test-user-password


# ----- 短信验证码配置 -----
# 短信服务商：aliyun | tencent | mock（默认 mock，开发环境不发送真实短信）
SMS_PROVIDER=mock
# 阿里云 AccessKeyId / AccessKeySecret（仅 SMS_PROVIDER=aliyun 时必填）
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
# 短信签名（仅 SMS_PROVIDER=aliyun 时必填）
SMS_SIGN_NAME=
# 登录验证码模板 ID / 重置密码模板 ID
SMS_TEMPLATE_CODE_LOGIN=
SMS_TEMPLATE_CODE_PASSWORD_RESET=
# 默认国家码
SMS_COUNTRY_CODE=+86
# 验证码 HMAC 密钥（必填）：用于哈希存储验证码，防止彩虹表攻击
# 生成命令：openssl rand -hex 32
# 注意：此密钥必须与 JWT 密钥不同，且部署后不可随意轮换，否则历史验证码无法验证
SMS_CODE_HMAC_KEY=
# 调试开关（仅限 mock 模式联调）：设为 true 时把明文验证码打印到服务端日志（pm2 logs 可见）。
# 默认为空即关闭；正式启用真实短信服务前必须删除此变量。
SMS_DEBUG_LOG_CODE=


# ----- 企业微信集成 (WeCom) -----
# 群机器人 Webhooks
# 常规联系留言通知
WECOM_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key
# 招聘/求职专门通道 (若未配置将回退到 WECOM_BOT_WEBHOOK)
WECOM_JOBS_WEBHOOK=

# ----- 文件上传与存储配置 -----
UPLOAD_MAX_SIZE=10485760
# 存储模式: oss (阿里云 OSS) 或 local (仅限本地且有持久卷的服务器)
STORAGE_MODE=local

# 阿里云 OSS (用于加速分析和高并发直传)
ALI_OSS_REGION=oss-cn-hangzhou
ALI_OSS_BUCKET=
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=
ALI_OSS_PUBLIC_DOMAIN=

# ----- 速率限制与代理配置 -----
# 限流存储方式：memory（单实例内存，仅本地开发）| database（PostgreSQL，支持多实例）
# 生产环境多实例部署必须设为 database
RATE_LIMIT_STORAGE=database
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# 是否信任 X-Forwarded-For / X-Real-IP 等代理头（生产环境 Nginx/ALB 后必须设为 true）
TRUST_PROXY=false
# 反向代理层数：从客户端开始计数，例如经过 2 层代理则设为 2
TRUST_PROXY_HOPS=1

# Token 黑名单存储方式：memory（单实例内存，仅本地开发）| database（PostgreSQL，支持多实例）
# 生产环境多实例部署必须设为 database
# 注：DPoP proof jti 防重放记录始终写入 TokenBlacklist 表（与 TOKEN_BLACKLIST_STORAGE 无关），
# 通过 key 唯一约束保证多实例下的跨实例重放拦截；OAuth Client 密钥轮换过渡期的旧 secret hash
# 持久化在 OAuthClient.previousSecretHash / secretRotatedAt 字段，多实例共享，无需额外配置。
TOKEN_BLACKLIST_STORAGE=database

# ----- 支付配置 (可选) -----
# 微信支付 (v3 API)
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/pay/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://your-domain.com/api/pay/refund-notify
# 微信支付平台公钥（主证书）
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PAY_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# 备用/历史平台证书（JSON 数组），用于微信证书轮换时的回调验签兜底
# 示例: [{"serialNo":"xxx","publicKey":"-----BEGIN PUBLIC KEY-----\n..."}]
WECHAT_PAY_PLATFORM_CERTS=
WECHAT_PAY_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 支付宝 (RSA2)
# 支持两种写法：完整 PEM（含 BEGIN/END 标记）或纯 base64 body，代码会自动识别
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ALIPAY_NOTIFY_URL=https://your-domain.com/api/pay/alipay-notify
# 手机网站支付完成后跳转回站点的地址（当前用户中心为弹窗，建议填首页 /）
ALIPAY_RETURN_URL=https://your-domain.com/

# 支付方式开关配置 (格式: 支付方式ID:是否启用:优先级)
# 例如: wechat:true:1,alipay:true:2
PAYMENT_METHODS_CONFIG=

# ----- 高德地图 (前端地图定位服务) -----
# AMAP_KEY: API 密钥（前端使用，通过 NEXT_PUBLIC_AMAP_KEY 暴露到客户端）
# AMAP_SECRET: JS API 安全密钥（服务端组件 SSR 注入到 HTML，不进入 JS bundle）
#   管理后台 AmapLocationPicker 客户端组件通过 server props 接收
AMAP_KEY=
AMAP_SECRET=
NEXT_PUBLIC_AMAP_KEY=

# ----- 定时任务 -----
# 用于保护 /api/cron/* 端点，防止外部未授权访问
# 建议：随机生成至少 32 位的强密钥
CRON_SECRET=your-very-strong-random-secret-min-32-chars
# 是否启用进程内定时任务（订单超时取消、自动完成、主动查询支付状态等）
# 生产环境如使用外部调度器（如 K8s CronJob），可设为 false
ENABLE_LOCAL_CRON=true

# ----- 百度 SEO 配置 -----
# 百度统计 ID（百度统计 -> 管理 -> 代码获取 -> hm.js? 后面的字符串）
NEXT_PUBLIC_BAIDU_TONGJI_ID=
# 百度主动推送 Token（百度站长平台 -> 数据引入 -> 链接提交 -> 找到接口调用地址中的 token）
BAIDU_PUSH_TOKEN=

# ----- Google SEO 配置 -----
# Google Analytics GA4 测量 ID（格式：G-XXXXXXXXXX）
# 获取：Google Analytics -> 管理 -> 数据流 -> 复制测量 ID
NEXT_PUBLIC_GA_ID=

# ----- 顺丰丰桥物流 -----
# 顺丰开放平台配置，用于查询真实物流轨迹
# 申请地址：https://open.sf-express.com/
SF_EXPRESS_CUSTOMER_CODE=
SF_EXPRESS_CHECK_WORD=

# ----- AI / DeepSeek 配置 -----
# 用于 AI 皮肤顾问等功能
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ----- 邮件 SMTP 配置 -----
# 用于发送系统通知、告警邮件
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nihplod.cn
SMTP_FROM_NAME=NIHPLOD
NOTIFICATION_EMAIL=

# ----- Cloudinary 图片云存储（可选，不使用可留空）-----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- 环境配置 -----
NODE_ENV=production

# ============================================
# 微信公众号 / 小程序（JS-SDK 分享、小程序登录与手机号快速验证）
# ============================================
# 微信公众号（JS-SDK 自定义分享）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# 小程序（code2session / getPhoneNumber）：必须与商城小程序 appId 一致，openid/unionid 才一致；
# 未配置时回退 WECHAT_APP_ID / WECHAT_APP_SECRET
# WECHAT_MINIPROGRAM_APP_ID=
# WECHAT_MINIPROGRAM_APP_SECRET=
