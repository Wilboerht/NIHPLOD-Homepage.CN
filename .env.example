# ===========================================
# NIHPLOD.CN 环境变量配置示例
# 复制此文件为 .env.local 并填写实际值
# ===========================================

# ----- 应用配置 -----
NEXT_PUBLIC_APP_NAME=NIHPLOD
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DESCRIPTION=逆转时光

# ----- 数据库配置 (Prisma) -----
DATABASE_URL="postgresql://username:password@localhost:5432/nihplod?schema=public"

# ----- 认证配置 -----
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@nihplod.cn
ADMIN_PASSWORD=your-secure-admin-password

# ----- AI 配置 -----
# AI 功能总开关
AI_ENABLED=true

# 文本分析服务商 (openai | deepseek | anthropic | qwen)
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat

# 视觉分析服务商 (openai | anthropic | qwen)
AI_VISION_PROVIDER=openai

# OpenAI 配置
OPENAI_API_KEY=your-openai-api-key

# DeepSeek 配置 (推荐：性价比最高)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问配置 (推荐：国内访问稳定，中文优秀)
# 获取 API Key: https://dashscope.console.aliyun.com/
QWEN_API_KEY=your-qwen-api-key
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 文本模型: qwen-turbo (最快), qwen-plus (均衡), qwen-max (最强)
QWEN_VL_MODEL=qwen-vl-max
# 视觉模型: qwen-vl-plus (均衡), qwen-vl-max (最强)

# Anthropic 配置 (可选)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# -----  推荐配置方案 -----
# 方案A（性价比优先）: AI_PROVIDER=deepseek, AI_VISION_PROVIDER=openai
# 方案B（国内优先）: AI_PROVIDER=qwen, QWEN_MODEL=qwen-plus, AI_VISION_PROVIDER=qwen
# 方案C（效果最佳）: AI_PROVIDER=openai, AI_MODEL=gpt-4o, AI_VISION_PROVIDER=openai
# 详见 docs/AI-Model-Selection-Report.md

# ----- 邮件配置 (SMTP) -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@nihplod.cn
SMTP_FROM_NAME=NIHPLOD
NOTIFICATION_EMAIL=admin@nihplod.cn

# ----- 文件上传配置 -----
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif

# ----- 速率限制配置 -----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ----- 第三方服务 (可选) -----
# 图片存储 (如使用云存储)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# 分析统计 (如使用 Google Analytics)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ----- 微信分享配置 (可选) -----
# 需要在微信公众平台获取
# WECHAT_APP_ID=your-wechat-app-id
# WECHAT_APP_SECRET=your-wechat-app-secret

# ----- 开发配置 -----
NODE_ENV=development

