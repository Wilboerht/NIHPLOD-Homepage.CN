# ===========================================
# NIHPLOD.CN 环境变量配置示例
# 复制此文件为 .env.local 并填写实际值
# ===========================================

# ----- 应用配置 -----
NEXT_PUBLIC_APP_NAME=NIHPLOD
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DESCRIPTION=高端婚礼花艺定制

# ----- 数据库配置 (Prisma) -----
DATABASE_URL="postgresql://username:password@localhost:5432/nihplod?schema=public"

# ----- 认证配置 -----
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@nihplod.cn
ADMIN_PASSWORD=your-secure-admin-password

# ----- AI 配置 (DeepSeek) -----
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ----- 邮件配置 (SMTP) -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@nihplod.cn
SMTP_FROM_NAME=NIHPLOD
NOTIFICATION_EMAIL=admin@nihplod.cn

# ----- 文件上传配置 -----
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif

# ----- 速率限制配置 -----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ----- 第三方服务 (可选) -----
# 图片存储 (如使用云存储)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# 分析统计 (如使用 Google Analytics)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ----- 开发配置 -----
NODE_ENV=development

