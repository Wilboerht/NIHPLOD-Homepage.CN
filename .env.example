# ===========================================
# NIHPLOD.CN 环境变量配置示例
# 复制此文件为 .env.local 并填写实际值
# ===========================================

# ----- 应用配置 -----
NEXT_PUBLIC_APP_NAME=NIHPLOD
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DESCRIPTION=逆转时光

# ----- 数据库配置 (Prisma) -----
# 本地开发使用普通连接
DATABASE_URL="postgresql://username:password@localhost:5432/nihplod?schema=public"
# Supabase 生产环境使用 Transaction 模式 (端口 6543 + pgbouncer=true)
# DATABASE_URL="postgresql://postgres.xxx:password@xxx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ----- 认证配置 -----
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@nihplod.cn
ADMIN_PASSWORD=your-secure-admin-password

# ----- AI 配置 -----
# AI 功能总开关
AI_ENABLED=true

# 文本分析服务商 (openai | deepseek | anthropic | qwen)
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat

# 视觉分析服务商 (openai | anthropic | qwen)
AI_VISION_PROVIDER=qwen

# =====================================================
# 多 API Key 配置（高并发负载均衡）
# =====================================================
# 支持配置多个 API Key，用逗号分隔，系统会自动轮询
# 当一个 Key 限流或失败时，会自动切换到下一个 Key
# 每个新账号都有免费额度，建议注册多个账号提高吞吐量

# OpenAI 配置（支持多 Key，用逗号分隔）
OPENAI_API_KEY=sk-key1,sk-key2,sk-key3
# OPENAI_API_URL=https://api.openai.com/v1  # 可选：自定义端点（如代理服务器）

# DeepSeek 配置（推荐：性价比最高，支持多 Key）
DEEPSEEK_API_KEY=sk-deepseek-key1,sk-deepseek-key2
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问配置（推荐：国内访问稳定，中文优秀，支持多 Key）
# 获取 API Key: https://dashscope.console.aliyun.com/
QWEN_API_KEY=sk-qwen-key1,sk-qwen-key2,sk-qwen-key3
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 文本模型: qwen-turbo (最快), qwen-plus (均衡), qwen-max (最强)
QWEN_VL_MODEL=qwen-vl-max
# 视觉模型: qwen-vl-plus (均衡), qwen-vl-max (最强)

# Anthropic 配置（可选，支持多 Key）
# ANTHROPIC_API_KEY=sk-ant-key1,sk-ant-key2
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages  # 可选：自定义端点

# =====================================================
# 推荐配置方案
# =====================================================
# 方案A（性价比优先）: AI_PROVIDER=deepseek, AI_VISION_PROVIDER=qwen
# 方案B（国内优先）: AI_PROVIDER=qwen, QWEN_MODEL=qwen-plus, AI_VISION_PROVIDER=qwen
# 方案C（效果最佳）: AI_PROVIDER=openai, AI_MODEL=gpt-4o, AI_VISION_PROVIDER=openai
# 详见 docs/AI-Model-Selection-Report.md
#
# 高并发配置建议：
# - 每个服务商配置 3 个 API Key
# - 通义千问免费额度：100万 tokens/新账号
# - DeepSeek 免费额度：500万 tokens/新账号

# =====================================================
# AI 请求队列配置
# =====================================================
# 控制同时处理的 AI 请求数量，超出的请求会排队等待
# 默认值 10，可根据服务器配置和 AI 服务商限流调整
AI_QUEUE_MAX_CONCURRENT=10

# ----- 邮件配置 (SMTP) -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@nihplod.cn
SMTP_FROM_NAME=NIHPLOD
NOTIFICATION_EMAIL=admin@nihplod.cn

# ----- 文件上传配置 -----
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf

# ----- 文件存储配置 (Supabase Storage) -----
# 存储模式: supabase (云端，推荐) 或 local (本地，仅自有服务器)
STORAGE_MODE=supabase

# Supabase 配置 (从 Supabase 控制台获取)
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Project Settings -> API -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API -> service_role (仅服务端使用，勿泄露)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- 速率限制配置 -----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# 分析统计 (如使用 Google Analytics)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ----- 微信分享配置 (可选) -----
# 需要在微信公众平台获取
# WECHAT_APP_ID=your-wechat-app-id
# WECHAT_APP_SECRET=your-wechat-app-secret

# ----- 开发配置 -----
NODE_ENV=development

