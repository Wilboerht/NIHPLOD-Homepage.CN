# .env.production 支付配置模板
# 
# 说明：
# 1. 本文件包含生产环境所有支付配置模板
# 2. 使用的值都是占位符，需要替换为实际商务配置
# 3. 密钥中的 \n 需要正确转义为 \\n
# 4. 所有敏感信息应该存储在安全的配置管理系统中
#

# ==============================================================================
# 7. 支付配置 (Payments) - 生产环境完整版
# ==============================================================================

# ============================================================================
# 7.1 微信支付 (API v3) - 必需配置
# ============================================================================
# 
# 来源: 微信支付商户平台 (https://pay.weixin.qq.com/)
# 步骤:
#   1. 登录商户平台 → 账户中心 → API安全 获取 APIv3 密钥
#   2. 获取商户证书序列号和私钥
#   3. 下载微信平台公钥
#

# 微信公众号/小程序 App ID
WECHAT_PAY_APP_ID="wxd7e6b5a4c3f2e1d0"

# 微信支付商户号
WECHAT_PAY_MCH_ID="1670987654"

# APIv3 密钥 (32字节随机字符)
# 获取方式: 微信商户平台 → 账户中心 → API安全 → 设置或查看 API v3 密钥
WECHAT_PAY_API_V3_KEY="Nihplod_Wechat_Pay_V3_Key_2024_01"

# 支付通知回调 URL
WECHAT_PAY_NOTIFY_URL="https://nihplod.cn/api/pay/notify/wechat"

# 退款通知回调 URL (可选, 某些情况下需要)
WECHAT_PAY_REFUND_NOTIFY_URL="https://nihplod.cn/api/pay/refund-notify/wechat"

# 商户证书序列号
# 获取方式: 微信商户平台 → 账户中心 → API安全 → 证书里查看
WECHAT_PAY_SERIAL_NO="3A5C7E9B1D0F2E4A6C8B0D2F4E6A8C0B2D4E6F8"

# 商户私钥 (PEM格式)
# ⚠️ 重要: 密钥中的 \n 必须转义为 \\n (两个反斜杠)
# 获取方式: 下载服务商证书，解析 apiclient_key.pem
WECHAT_PAY_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDCM3t8o/aTAVzS\\n...（省略中间内容）\\n-----END RSA PRIVATE KEY-----"

# 微信平台公钥 (PEM格式)
# ⚠️ 重要: 同样需要转义 \n
# 获取方式: 微信支付 API 获取或商户平台下载
WECHAT_PAY_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA1c4V7B5a8d3K4f5gH6mK\\n...（省略中间内容）\\n-----END PUBLIC KEY-----"

# 微信平台公钥 ID
# 获取方式: 通过微信 API 或商户平台查看
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID="5v6132d8c05a8e123xxxx"


# ============================================================================
# 7.2 支付宝支付 (WAP Pay) - 必需配置
# ============================================================================
#
# 来源: 支付宝开放平台 (https://open.alipay.com/)
# 步骤:
#   1. 创建或登录应用
#   2. 生成应用公钥/私钥对
#   3. 获取支付宝公钥
#

# 支付宝应用 ID
# 获取方式: 支付宝开放平台 → 我的应用 → 应用ID
ALIPAY_APP_ID="2021002189xxxxxx"

# 应用私钥 (2048 RSA)
# ⚠️ 重要: \n 转义为 \\n，注意行长度限制
# 获取方式: 支付宝开放平台 → 开发设置 → 密钥管理 → 自己保管的私钥
ALIPAY_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\\nMIIEpAIBAAKCAQEA1c4V7B5a8d3K4f5gH6mK2n7o8p9q0r1s2t3u4v5w6x7y8z9aB\\n...（省略中间内容）\\n-----END RSA PRIVATE KEY-----"

# 支付宝公钥
# 获取方式: 支付宝开放平台 → 开发设置 → 密钥管理 → 支付宝公钥
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA1c4V7B5a8d3K4f5gH6mK\\n...（省略中间内容）\\n-----END PUBLIC KEY-----"

# 支付成功异步通知 URL
ALIPAY_NOTIFY_URL="https://nihplod.cn/api/pay/alipay-notify"

# 支付完成后用户返回 URL
ALIPAY_RETURN_URL="https://nihplod.cn/pay/success"


# ============================================================================
# 7.4 支付方式启用控制
# ============================================================================
#
# 格式: 支付方式ID:是否启用:优先级
# 例如: wechat:true:1,alipay:true:2
#
# 这个配置决定:
#   - 哪些支付方式在前端显示
#   - 支付方式的显示顺序
#

# 推荐配置 (微信优先):
PAYMENT_METHODS_CONFIG="wechat:true:1,alipay:true:2"


